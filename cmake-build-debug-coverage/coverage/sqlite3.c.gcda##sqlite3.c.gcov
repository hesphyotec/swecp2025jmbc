        -: 1570:#define SQLITE_FCNTL_VFS_POINTER            27
        -: 1571:#define SQLITE_FCNTL_JOURNAL_POINTER        28
        -: 1572:#define SQLITE_FCNTL_WIN32_GET_HANDLE       29
        -: 1573:#define SQLITE_FCNTL_PDB                    30
