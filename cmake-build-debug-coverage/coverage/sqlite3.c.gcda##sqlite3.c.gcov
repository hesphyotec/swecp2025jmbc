        -:198348:SQLITE_PRIVATE const char *sqlite3Fts3NextToken(const char *zStr, int *pn){
        -:198349:  const char *z1;
        -:198350:  const char *z2 = 0;
        -:198351:
        -:198352:  /* Find the start of the next token. */
        -:198353:  z1 = zStr;
        -:198354:  while( z2==0 ){
        -:198355:    char c = *z1;
        -:198356:    switch( c ){
        -:198357:      case '\0': return 0;        /* No more tokens here */
        -:198358:      case '\'':
        -:198359:      case '"':
        -:198360:      case '`': {
        -:198361:        z2 = z1;
        -:198362:        while( *++z2 && (*z2!=c || *++z2==c) );
        -:198363:        break;
        -:198364:      }
        -:198365:      case '[':
        -:198366:        z2 = &z1[1];
        -:198367:        while( *z2 && z2[0]!=']' ) z2++;
        -:198368:        if( *z2 ) z2++;
        -:198369:        break;
        -:198370:
        -:198371:      default:
        -:198372:        if( sqlite3Fts3IsIdChar(*z1) ){
        -:198373:          z2 = &z1[1];
        -:198374:          while( sqlite3Fts3IsIdChar(*z2) ) z2++;
        -:198375:        }else{
        -:198376:          z1++;
        -:198377:        }
        -:198378:    }
        -:198379:  }
        -:198380:
        -:198381:  *pn = (int)(z2-z1);
        -:198382:  return z1;
        -:198383:}
