        -:66203:  u8 isInit;                      /* 1 when initialized */
        -:66204:  u8 bigEndCksum;                 /* True if checksums in WAL are big-endian */
        -:66205:  u16 szPage;                     /* Database page size in bytes. 1==64K */
        -:66206:  u32 mxFrame;                    /* Index of last valid frame in the WAL */
        -:66207:  u32 nPage;                      /* Size of database in pages */
        -:66208:  u32 aFrameCksum[2];             /* Checksum of last frame in log */
        -:66209:  u32 aSalt[2];                   /* Two salt values copied from WAL header */
        -:66210:  u32 aCksum[2];                  /* Checksum over all prior fields */
        -:66211:};
        -:66212:
        -:66213:/*
        -:66214:** A copy of the following object occurs in the wal-index immediately
        -:66215:** following the second copy of the WalIndexHdr.  This object stores
        -:66216:** information used by checkpoint.
        -:66217:**
        -:66218:** nBackfill is the number of frames in the WAL that have been written
        -:66219:** back into the database. (We call the act of moving content from WAL to
        -:66220:** database "backfilling".)  The nBackfill number is never greater than
        -:66221:** WalIndexHdr.mxFrame.  nBackfill can only be increased by threads
        -:66222:** holding the WAL_CKPT_LOCK lock (which includes a recovery thread).
        -:66223:** However, a WAL_WRITE_LOCK thread can move the value of nBackfill from
        -:66224:** mxFrame back to zero when the WAL is reset.
        -:66225:**
        -:66226:** nBackfillAttempted is the largest value of nBackfill that a checkpoint
        -:66227:** has attempted to achieve.  Normally nBackfill==nBackfillAtempted, however
        -:66228:** the nBackfillAttempted is set before any backfilling is done and the
        -:66229:** nBackfill is only set after all backfilling completes.  So if a checkpoint
        -:66230:** crashes, nBackfillAttempted might be larger than nBackfill.  The
        -:66231:** WalIndexHdr.mxFrame must never be less than nBackfillAttempted.
        -:66232:**
        -:66233:** The aLock[] field is a set of bytes used for locking.  These bytes should
        -:66234:** never be read or written.
        -:66235:**
        -:66236:** There is one entry in aReadMark[] for each reader lock.  If a reader
        -:66237:** holds read-lock K, then the value in aReadMark[K] is no greater than
        -:66238:** the mxFrame for that reader.  The value READMARK_NOT_USED (0xffffffff)
        -:66239:** for any aReadMark[] means that entry is unused.  aReadMark[0] is
        -:66240:** a special case; its value is never used and it exists as a place-holder
