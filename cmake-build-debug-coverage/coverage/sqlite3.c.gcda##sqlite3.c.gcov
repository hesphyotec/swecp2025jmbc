        -:159171:  LogEst rCost;         /* Total cost of this path */
        -:159172:  LogEst rUnsort;       /* Total cost of this path ignoring sorting costs */
        -:159173:  i8 isOrdered;         /* No. of ORDER BY terms satisfied. -1 for unknown */
        -:159174:  WhereLoop **aLoop;    /* Array of WhereLoop objects implementing this path */
        -:159175:};
        -:159176:
        -:159177:/*
        -:159178:** The query generator uses an array of instances of this structure to
        -:159179:** help it analyze the subexpressions of the WHERE clause.  Each WHERE
        -:159180:** clause subexpression is separated from the others by AND operators,
        -:159181:** usually, or sometimes subexpressions separated by OR.
        -:159182:**
        -:159183:** All WhereTerms are collected into a single WhereClause structure.
        -:159184:** The following identity holds:
        -:159185:**
        -:159186:**        WhereTerm.pWC->a[WhereTerm.idx] == WhereTerm
        -:159187:**
        -:159188:** When a term is of the form:
        -:159189:**
        -:159190:**              X <op> <expr>
        -:159191:**
        -:159192:** where X is a column name and <op> is one of certain operators,
        -:159193:** then WhereTerm.leftCursor and WhereTerm.u.leftColumn record the
        -:159194:** cursor number and column number for X.  WhereTerm.eOperator records
        -:159195:** the <op> using a bitmask encoding defined by WO_xxx below.  The
        -:159196:** use of a bitmask encoding for the operator allows us to search
        -:159197:** quickly for terms that match any of several different operators.
        -:159198:**
        -:159199:** A WhereTerm might also be two or more subterms connected by OR:
        -:159200:**
        -:159201:**         (t1.X <op> <expr>) OR (t1.Y <op> <expr>) OR ....
        -:159202:**
        -:159203:** In this second case, wtFlag has the TERM_ORINFO bit set and eOperator==WO_OR
        -:159204:** and the WhereTerm.u.pOrInfo field points to auxiliary information that
        -:159205:** is collected about the OR clause.
        -:159206:**
        -:159207:** If a term in the WHERE clause does not match either of the two previous
        -:159208:** categories, then eOperator==0.  The WhereTerm.pExpr field is still set
        -:159209:** to the original subexpression content and wtFlags is set up appropriately
        -:159210:** but no other fields in the WhereTerm object are meaningful.
        -:159211:**
        -:159212:** When eOperator!=0, prereqRight and prereqAll record sets of cursor numbers,
        -:159213:** but they do so indirectly.  A single WhereMaskSet structure translates
        -:159214:** cursor number into bits and the translated bit is stored in the prereq
        -:159215:** fields.  The translation is used in order to maximize the number of
        -:159216:** bits that will fit in a Bitmask.  The VDBE cursor numbers might be
        -:159217:** spread out over the non-negative integers.  For example, the cursor
        -:159218:** numbers might be 3, 8, 9, 10, 20, 23, 41, and 45.  The WhereMaskSet
        -:159219:** translates these sparse cursor numbers into consecutive integers
        -:159220:** beginning with 0 in order to make the best possible use of the available
        -:159221:** bits in the Bitmask.  So, in the example above, the cursor numbers
        -:159222:** would be mapped into integers 0 through 7.
        -:159223:**
        -:159224:** The number of terms in a join is limited by the number of bits
        -:159225:** in prereqRight and prereqAll.  The default is 64 bits, hence SQLite
        -:159226:** is only able to process joins with 64 or fewer tables.
        -:159227:*/
        -:159228:struct WhereTerm {
        -:159229:  Expr *pExpr;            /* Pointer to the subexpression that is this term */
        -:159230:  WhereClause *pWC;       /* The clause this term is part of */
        -:159231:  LogEst truthProb;       /* Probability of truth for this expression */
        -:159232:  u16 wtFlags;            /* TERM_xxx bit flags.  See below */
        -:159233:  u16 eOperator;          /* A WO_xx value describing <op> */
        -:159234:  u8 nChild;              /* Number of children that must disable us */
        -:159235:  u8 eMatchOp;            /* Op for vtab MATCH/LIKE/GLOB/REGEXP terms */
        -:159236:  int iParent;            /* Disable pWC->a[iParent] when this term disabled */
        -:159237:  int leftCursor;         /* Cursor number of X in "X <op> <expr>" */
        -:159238:  union {
        -:159239:    struct {
        -:159240:      int leftColumn;         /* Column number of X in "X <op> <expr>" */
        -:159241:      int iField;             /* Field in (?,?,?) IN (SELECT...) vector */
        -:159242:    } x;                    /* Opcode other than OP_OR or OP_AND */
        -:159243:    WhereOrInfo *pOrInfo;   /* Extra information if (eOperator & WO_OR)!=0 */
        -:159244:    WhereAndInfo *pAndInfo; /* Extra information if (eOperator& WO_AND)!=0 */
        -:159245:  } u;
        -:159246:  Bitmask prereqRight;    /* Bitmask of tables used by pExpr->pRight */
        -:159247:  Bitmask prereqAll;      /* Bitmask of tables referenced by pExpr */
        -:159248:};
        -:159249:
        -:159250:/*
        -:159251:** Allowed values of WhereTerm.wtFlags
        -:159252:*/
        -:159253:#define TERM_DYNAMIC    0x0001 /* Need to call sqlite3ExprDelete(db, pExpr) */
        -:159254:#define TERM_VIRTUAL    0x0002 /* Added by the optimizer.  Do not code */
