        -:197079:  zTokenizer = (const char*)sqlite3_value_text(argv[0]);
        -:197080:  rc = sqlite3Fts3InitTokenizer(pHash, zTokenizer, &pTokenizer, &zErr);
        -:197081:  if( rc!=SQLITE_OK ){
        -:197082:    if( rc==SQLITE_NOMEM ){
        -:197083:      sqlite3_result_error_nomem(context);
        -:197084:    }else{
        -:197085:      sqlite3_result_error(context, zErr, -1);
        -:197086:    }
        -:197087:    sqlite3_free(zErr);
        -:197088:    return;
        -:197089:  }
        -:197090:
        -:197091:  zExpr = (const char *)sqlite3_value_text(argv[1]);
        -:197092:  nExpr = sqlite3_value_bytes(argv[1]);
        -:197093:  nCol = argc-2;
