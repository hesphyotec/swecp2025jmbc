        -:19831:
        -:19832:/*
        -:19833:** A NameContext defines a context in which to resolve table and column
        -:19834:** names.  The context consists of a list of tables (the pSrcList) field and
        -:19835:** a list of named expression (pEList).  The named expression list may
        -:19836:** be NULL.  The pSrc corresponds to the FROM clause of a SELECT or
        -:19837:** to the table being operated on by INSERT, UPDATE, or DELETE.  The
        -:19838:** pEList corresponds to the result set of a SELECT and is NULL for
        -:19839:** other statements.
        -:19840:**
        -:19841:** NameContexts can be nested.  When resolving names, the inner-most
        -:19842:** context is searched first.  If no match is found, the next outer
        -:19843:** context is checked.  If there is still no match, the next context
        -:19844:** is checked.  This process continues until either a match is found
        -:19845:** or all contexts are check.  When a match is found, the nRef member of
        -:19846:** the context containing the match is incremented.
        -:19847:**
        -:19848:** Each subquery gets a new NameContext.  The pNext field points to the
        -:19849:** NameContext in the parent query.  Thus the process of scanning the
        -:19850:** NameContext list corresponds to searching through successively outer
        -:19851:** subqueries looking for a match.
        -:19852:*/
        -:19853:struct NameContext {
        -:19854:  Parse *pParse;       /* The parser */
        -:19855:  SrcList *pSrcList;   /* One or more tables used to resolve names */
        -:19856:  union {
        -:19857:    ExprList *pEList;    /* Optional list of result-set columns */
        -:19858:    AggInfo *pAggInfo;   /* Information about aggregates at this level */
        -:19859:    Upsert *pUpsert;     /* ON CONFLICT clause information from an upsert */
        -:19860:    int iBaseReg;        /* For TK_REGISTER when parsing RETURNING */
        -:19861:  } uNC;
        -:19862:  NameContext *pNext;  /* Next outer name context.  NULL for outermost */
        -:19863:  int nRef;            /* Number of names resolved by this context */
        -:19864:  int nNcErr;          /* Number of errors encountered while resolving names */
        -:19865:  int ncFlags;         /* Zero or more NC_* flags defined below */
        -:19866:  u32 nNestedSelect;   /* Number of nested selects using this NC */
        -:19867:  Select *pWinSelect;  /* SELECT statement for any window functions */
        -:19868:};
        -:19869:
        -:19870:/*
        -:19871:** Allowed values for the NameContext, ncFlags field.
        -:19872:**
        -:19873:** Value constraints (all checked via assert()):
        -:19874:**    NC_HasAgg    == SF_HasAgg       == EP_Agg
        -:19875:**    NC_MinMaxAgg == SF_MinMaxAgg    == SQLITE_FUNC_MINMAX
        -:19876:**    NC_OrderAgg  == SF_OrderByReqd  == SQLITE_FUNC_ANYORDER
        -:19877:**    NC_HasWin    == EP_Win
        -:19878:**
        -:19879:*/
        -:19880:#define NC_AllowAgg  0x000001 /* Aggregate functions are allowed here */
        -:19881:#define NC_PartIdx   0x000002 /* True if resolving a partial index WHERE */
        -:19882:#define NC_IsCheck   0x000004 /* True if resolving a CHECK constraint */
        -:19883:#define NC_GenCol    0x000008 /* True for a GENERATED ALWAYS AS clause */
        -:19884:#define NC_HasAgg    0x000010 /* One or more aggregate functions seen */
        -:19885:#define NC_IdxExpr   0x000020 /* True if resolving columns of CREATE INDEX */
        -:19886:#define NC_SelfRef   0x00002e /* Combo: PartIdx, isCheck, GenCol, and IdxExpr */
        -:19887:#define NC_Subquery  0x000040 /* A subquery has been seen */
        -:19888:#define NC_UEList    0x000080 /* True if uNC.pEList is used */
        -:19889:#define NC_UAggInfo  0x000100 /* True if uNC.pAggInfo is used */
        -:19890:#define NC_UUpsert   0x000200 /* True if uNC.pUpsert is used */
        -:19891:#define NC_UBaseReg  0x000400 /* True if uNC.iBaseReg is used */
        -:19892:#define NC_MinMaxAgg 0x001000 /* min/max aggregates seen.  See note above */
        -:19893:/*                   0x002000 // available for reuse */
        -:19894:#define NC_AllowWin  0x004000 /* Window functions are allowed here */
        -:19895:#define NC_HasWin    0x008000 /* One or more window functions seen */
        -:19896:#define NC_IsDDL     0x010000 /* Resolving names in a CREATE statement */
        -:19897:#define NC_InAggFunc 0x020000 /* True if analyzing arguments to an agg func */
        -:19898:#define NC_FromDDL   0x040000 /* SQL text comes from sqlite_schema */
        -:19899:#define NC_NoSelect  0x080000 /* Do not descend into sub-selects */
        -:19900:#define NC_Where     0x100000 /* Processing WHERE clause of a SELECT */
        -:19901:#define NC_OrderAgg 0x8000000 /* Has an aggregate other than count/min/max */
        -:19902:
        -:19903:/*
        -:19904:** An instance of the following object describes a single ON CONFLICT
        -:19905:** clause in an upsert.
        -:19906:**
        -:19907:** The pUpsertTarget field is only set if the ON CONFLICT clause includes
        -:19908:** conflict-target clause.  (In "ON CONFLICT(a,b)" the "(a,b)" is the
        -:19909:** conflict-target clause.)  The pUpsertTargetWhere is the optional
        -:19910:** WHERE clause used to identify partial unique indexes.
        -:19911:**
        -:19912:** pUpsertSet is the list of column=expr terms of the UPDATE statement.
        -:19913:** The pUpsertSet field is NULL for a ON CONFLICT DO NOTHING.  The
        -:19914:** pUpsertWhere is the WHERE clause for the UPDATE and is NULL if the
        -:19915:** WHERE clause is omitted.
        -:19916:*/
        -:19917:struct Upsert {
        -:19918:  ExprList *pUpsertTarget;  /* Optional description of conflict target */
        -:19919:  Expr *pUpsertTargetWhere; /* WHERE clause for partial index targets */
        -:19920:  ExprList *pUpsertSet;     /* The SET clause from an ON CONFLICT UPDATE */
        -:19921:  Expr *pUpsertWhere;       /* WHERE clause for the ON CONFLICT UPDATE */
        -:19922:  Upsert *pNextUpsert;      /* Next ON CONFLICT clause in the list */
        -:19923:  u8 isDoUpdate;            /* True for DO UPDATE.  False for DO NOTHING */
        -:19924:  u8 isDup;                 /* True if 2nd or later with same pUpsertIdx */
        -:19925:  /* Above this point is the parse tree for the ON CONFLICT clauses.
        -:19926:  ** The next group of fields stores intermediate data. */
        -:19927:  void *pToFree;            /* Free memory when deleting the Upsert object */
        -:19928:  /* All fields above are owned by the Upsert object and must be freed
        -:19929:  ** when the Upsert is destroyed.  The fields below are used to transfer
        -:19930:  ** information from the INSERT processing down into the UPDATE processing
        -:19931:  ** while generating code.  The fields below are owned by the INSERT
        -:19932:  ** statement and will be freed by INSERT processing. */
        -:19933:  Index *pUpsertIdx;        /* UNIQUE constraint specified by pUpsertTarget */
        -:19934:  SrcList *pUpsertSrc;      /* Table to be updated */
        -:19935:  int regData;              /* First register holding array of VALUES */
        -:19936:  int iDataCur;             /* Index of the data cursor */
        -:19937:  int iIdxCur;              /* Index of the first index cursor */
        -:19938:};
        -:19939:
        -:19940:/*
        -:19941:** An instance of the following structure contains all information
        -:19942:** needed to generate code for a single SELECT statement.
        -:19943:**
        -:19944:** See the header comment on the computeLimitRegisters() routine for a
        -:19945:** detailed description of the meaning of the iLimit and iOffset fields.
        -:19946:**
        -:19947:** addrOpenEphm[] entries contain the address of OP_OpenEphemeral opcodes.
        -:19948:** These addresses must be stored so that we can go back and fill in
        -:19949:** the P4_KEYINFO and P2 parameters later.  Neither the KeyInfo nor
        -:19950:** the number of columns in P2 can be computed at the same time
        -:19951:** as the OP_OpenEphm instruction is coded because not
        -:19952:** enough information about the compound query is known at that point.
        -:19953:** The KeyInfo for addrOpenTran[0] and [1] contains collating sequences
        -:19954:** for the result set.  The KeyInfo for addrOpenEphm[2] contains collating
        -:19955:** sequences for the ORDER BY clause.
        -:19956:*/
        -:19957:struct Select {
        -:19958:  u8 op;                 /* One of: TK_UNION TK_ALL TK_INTERSECT TK_EXCEPT */
        -:19959:  LogEst nSelectRow;     /* Estimated number of result rows */
        -:19960:  u32 selFlags;          /* Various SF_* values */
        -:19961:  int iLimit, iOffset;   /* Memory registers holding LIMIT & OFFSET counters */
        -:19962:  u32 selId;             /* Unique identifier number for this SELECT */
        -:19963:  int addrOpenEphm[2];   /* OP_OpenEphem opcodes related to this select */
        -:19964:  ExprList *pEList;      /* The fields of the result */
        -:19965:  SrcList *pSrc;         /* The FROM clause */
        -:19966:  Expr *pWhere;          /* The WHERE clause */
        -:19967:  ExprList *pGroupBy;    /* The GROUP BY clause */
        -:19968:  Expr *pHaving;         /* The HAVING clause */
        -:19969:  ExprList *pOrderBy;    /* The ORDER BY clause */
        -:19970:  Select *pPrior;        /* Prior select in a compound select statement */
        -:19971:  Select *pNext;         /* Next select to the left in a compound */
        -:19972:  Expr *pLimit;          /* LIMIT expression. NULL means not used. */
        -:19973:  With *pWith;           /* WITH clause attached to this select. Or NULL. */
        -:19974:#ifndef SQLITE_OMIT_WINDOWFUNC
        -:19975:  Window *pWin;          /* List of window functions */
        -:19976:  Window *pWinDefn;      /* List of named window definitions */
        -:19977:#endif
        -:19978:};
        -:19979:
        -:19980:/*
        -:19981:** Allowed values for Select.selFlags.  The "SF" prefix stands for
        -:19982:** "Select Flag".
        -:19983:**
        -:19984:** Value constraints (all checked via assert())
        -:19985:**     SF_HasAgg      == NC_HasAgg
        -:19986:**     SF_MinMaxAgg   == NC_MinMaxAgg     == SQLITE_FUNC_MINMAX
        -:19987:**     SF_OrderByReqd == NC_OrderAgg      == SQLITE_FUNC_ANYORDER
        -:19988:**     SF_FixedLimit  == WHERE_USE_LIMIT
        -:19989:*/
        -:19990:#define SF_Distinct      0x0000001 /* Output should be DISTINCT */
        -:19991:#define SF_All           0x0000002 /* Includes the ALL keyword */
        -:19992:#define SF_Resolved      0x0000004 /* Identifiers have been resolved */
        -:19993:#define SF_Aggregate     0x0000008 /* Contains agg functions or a GROUP BY */
        -:19994:#define SF_HasAgg        0x0000010 /* Contains aggregate functions */
        -:19995:#define SF_UsesEphemeral 0x0000020 /* Uses the OpenEphemeral opcode */
        -:19996:#define SF_Expanded      0x0000040 /* sqlite3SelectExpand() called on this */
        -:19997:#define SF_HasTypeInfo   0x0000080 /* FROM subqueries have Table metadata */
        -:19998:#define SF_Compound      0x0000100 /* Part of a compound query */
        -:19999:#define SF_Values        0x0000200 /* Synthesized from VALUES clause */
        -:20000:#define SF_MultiValue    0x0000400 /* Single VALUES term with multiple rows */
        -:20001:#define SF_NestedFrom    0x0000800 /* Part of a parenthesized FROM clause */
        -:20002:#define SF_MinMaxAgg     0x0001000 /* Aggregate containing min() or max() */
        -:20003:#define SF_Recursive     0x0002000 /* The recursive part of a recursive CTE */
        -:20004:#define SF_FixedLimit    0x0004000 /* nSelectRow set by a constant LIMIT */
        -:20005:#define SF_MaybeConvert  0x0008000 /* Need convertCompoundSelectToSubquery() */
        -:20006:#define SF_Converted     0x0010000 /* By convertCompoundSelectToSubquery() */
        -:20007:#define SF_IncludeHidden 0x0020000 /* Include hidden columns in output */
        -:20008:#define SF_ComplexResult 0x0040000 /* Result contains subquery or function */
        -:20009:#define SF_WhereBegin    0x0080000 /* Really a WhereBegin() call.  Debug Only */
        -:20010:#define SF_WinRewrite    0x0100000 /* Window function rewrite accomplished */
        -:20011:#define SF_View          0x0200000 /* SELECT statement is a view */
        -:20012:#define SF_NoopOrderBy   0x0400000 /* ORDER BY is ignored for this query */
        -:20013:#define SF_UFSrcCheck    0x0800000 /* Check pSrc as required by UPDATE...FROM */
        -:20014:#define SF_PushDown      0x1000000 /* Modified by WHERE-clause push-down opt */
        -:20015:#define SF_MultiPart     0x2000000 /* Has multiple incompatible PARTITIONs */
        -:20016:#define SF_CopyCte       0x4000000 /* SELECT statement is a copy of a CTE */
        -:20017:#define SF_OrderByReqd   0x8000000 /* The ORDER BY clause may not be omitted */
        -:20018:#define SF_UpdateFrom   0x10000000 /* Query originates with UPDATE FROM */
        -:20019:#define SF_Correlated   0x20000000 /* True if references the outer context */
        -:20020:
        -:20021:/* True if SrcItem X is a subquery that has SF_NestedFrom */
        -:20022:#define IsNestedFrom(X) \
        -:20023:   ((X)->fg.isSubquery && \
        -:20024:    ((X)->u4.pSubq->pSelect->selFlags&SF_NestedFrom)!=0)
        -:20025:
        -:20026:/*
        -:20027:** The results of a SELECT can be distributed in several ways, as defined
        -:20028:** by one of the following macros.  The "SRT" prefix means "SELECT Result
        -:20029:** Type".
        -:20030:**
        -:20031:**     SRT_Union       Store results as a key in a temporary index
        -:20032:**                     identified by pDest->iSDParm.
        -:20033:**
        -:20034:**     SRT_Except      Remove results from the temporary index pDest->iSDParm.
        -:20035:**
        -:20036:**     SRT_Exists      Store a 1 in memory cell pDest->iSDParm if the result
        -:20037:**                     set is not empty.
        -:20038:**
        -:20039:**     SRT_Discard     Throw the results away.  This is used by SELECT
        -:20040:**                     statements within triggers whose only purpose is
        -:20041:**                     the side-effects of functions.
        -:20042:**
        -:20043:**     SRT_Output      Generate a row of output (using the OP_ResultRow
        -:20044:**                     opcode) for each row in the result set.
        -:20045:**
        -:20046:**     SRT_Mem         Only valid if the result is a single column.
        -:20047:**                     Store the first column of the first result row
        -:20048:**                     in register pDest->iSDParm then abandon the rest
        -:20049:**                     of the query.  This destination implies "LIMIT 1".
        -:20050:**
        -:20051:**     SRT_Set         The result must be a single column.  Store each
        -:20052:**                     row of result as the key in table pDest->iSDParm.
        -:20053:**                     Apply the affinity pDest->affSdst before storing
        -:20054:**                     results.  if pDest->iSDParm2 is positive, then it is
        -:20055:**                     a register holding a Bloom filter for the IN operator
        -:20056:**                     that should be populated in addition to the
        -:20057:**                     pDest->iSDParm table.  This SRT is used to
        -:20058:**                     implement "IN (SELECT ...)".
        -:20059:**
        -:20060:**     SRT_EphemTab    Create an temporary table pDest->iSDParm and store
        -:20061:**                     the result there. The cursor is left open after
        -:20062:**                     returning.  This is like SRT_Table except that
        -:20063:**                     this destination uses OP_OpenEphemeral to create
        -:20064:**                     the table first.
        -:20065:**
        -:20066:**     SRT_Coroutine   Generate a co-routine that returns a new row of
        -:20067:**                     results each time it is invoked.  The entry point
        -:20068:**                     of the co-routine is stored in register pDest->iSDParm
        -:20069:**                     and the result row is stored in pDest->nDest registers
        -:20070:**                     starting with pDest->iSdst.
        -:20071:**
        -:20072:**     SRT_Table       Store results in temporary table pDest->iSDParm.
        -:20073:**     SRT_Fifo        This is like SRT_EphemTab except that the table
        -:20074:**                     is assumed to already be open.  SRT_Fifo has
        -:20075:**                     the additional property of being able to ignore
        -:20076:**                     the ORDER BY clause.
        -:20077:**
        -:20078:**     SRT_DistFifo    Store results in a temporary table pDest->iSDParm.
        -:20079:**                     But also use temporary table pDest->iSDParm+1 as
        -:20080:**                     a record of all prior results and ignore any duplicate
        -:20081:**                     rows.  Name means:  "Distinct Fifo".
        -:20082:**
        -:20083:**     SRT_Queue       Store results in priority queue pDest->iSDParm (really
        -:20084:**                     an index).  Append a sequence number so that all entries
        -:20085:**                     are distinct.
        -:20086:**
        -:20087:**     SRT_DistQueue   Store results in priority queue pDest->iSDParm only if
        -:20088:**                     the same record has never been stored before.  The
        -:20089:**                     index at pDest->iSDParm+1 hold all prior stores.
        -:20090:**
        -:20091:**     SRT_Upfrom      Store results in the temporary table already opened by
        -:20092:**                     pDest->iSDParm. If (pDest->iSDParm<0), then the temp
        -:20093:**                     table is an intkey table - in this case the first
        -:20094:**                     column returned by the SELECT is used as the integer
        -:20095:**                     key. If (pDest->iSDParm>0), then the table is an index
        -:20096:**                     table. (pDest->iSDParm) is the number of key columns in
        -:20097:**                     each index record in this case.
        -:20098:*/
        -:20099:#define SRT_Union        1  /* Store result as keys in an index */
        -:20100:#define SRT_Except       2  /* Remove result from a UNION index */
        -:20101:#define SRT_Exists       3  /* Store 1 if the result is not empty */
        -:20102:#define SRT_Discard      4  /* Do not save the results anywhere */
        -:20103:#define SRT_DistFifo     5  /* Like SRT_Fifo, but unique results only */
        -:20104:#define SRT_DistQueue    6  /* Like SRT_Queue, but unique results only */
        -:20105:
        -:20106:/* The DISTINCT clause is ignored for all of the above.  Not that
        -:20107:** IgnorableDistinct() implies IgnorableOrderby() */
        -:20108:#define IgnorableDistinct(X) ((X->eDest)<=SRT_DistQueue)
        -:20109:
        -:20110:#define SRT_Queue        7  /* Store result in an queue */
        -:20111:#define SRT_Fifo         8  /* Store result as data with an automatic rowid */
        -:20112:
        -:20113:/* The ORDER BY clause is ignored for all of the above */
        -:20114:#define IgnorableOrderby(X) ((X->eDest)<=SRT_Fifo)
        -:20115:
        -:20116:#define SRT_Output       9  /* Output each row of result */
        -:20117:#define SRT_Mem         10  /* Store result in a memory cell */
        -:20118:#define SRT_Set         11  /* Store results as keys in an index */
        -:20119:#define SRT_EphemTab    12  /* Create transient tab and store like SRT_Table */
        -:20120:#define SRT_Coroutine   13  /* Generate a single row of result */
        -:20121:#define SRT_Table       14  /* Store result as data with an automatic rowid */
        -:20122:#define SRT_Upfrom      15  /* Store result as data with rowid */
        -:20123:
        -:20124:/*
        -:20125:** An instance of this object describes where to put of the results of
        -:20126:** a SELECT statement.
        -:20127:*/
        -:20128:struct SelectDest {
        -:20129:  u8 eDest;            /* How to dispose of the results.  One of SRT_* above. */
