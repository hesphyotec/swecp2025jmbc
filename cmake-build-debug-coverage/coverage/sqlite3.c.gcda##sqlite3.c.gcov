        -:18004:  FuncDef *a[SQLITE_FUNC_HASH_SZ];       /* Hash table for functions */
        -:18005:};
        -:18006:#define SQLITE_FUNC_HASH(C,L) (((C)+(L))%SQLITE_FUNC_HASH_SZ)
