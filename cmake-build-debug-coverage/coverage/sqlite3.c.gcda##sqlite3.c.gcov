        -:197013:    }
        -:197014:
        -:197015:    case FTSQUERY_NEAR:
        -:197016:      zBuf = sqlite3_mprintf("%zNEAR/%d ", zBuf, pExpr->nNear);
        -:197017:      break;
        -:197018:    case FTSQUERY_NOT:
        -:197019:      zBuf = sqlite3_mprintf("%zNOT ", zBuf);
        -:197020:      break;
        -:197021:    case FTSQUERY_AND:
        -:197022:      zBuf = sqlite3_mprintf("%zAND ", zBuf);
        -:197023:      break;
        -:197024:    case FTSQUERY_OR:
        -:197025:      zBuf = sqlite3_mprintf("%zOR ", zBuf);
        -:197026:      break;
        -:197027:  }
        -:197028:
        -:197029:  if( zBuf ) zBuf = sqlite3_mprintf("%z{", zBuf);
        -:197030:  if( zBuf ) zBuf = exprToString(pExpr->pLeft, zBuf);
        -:197031:  if( zBuf ) zBuf = sqlite3_mprintf("%z} {", zBuf);
        -:197032:
        -:197033:  if( zBuf ) zBuf = exprToString(pExpr->pRight, zBuf);
        -:197034:  if( zBuf ) zBuf = sqlite3_mprintf("%z}", zBuf);
        -:197035:
        -:197036:  return zBuf;
        -:197037:}
