        -:159125:  WhereLoop *pNextLoop; /* Next WhereLoop object in the WhereClause */
        -:159126:  WhereTerm *aLTermSpace[3];  /* Initial aLTerm[] space */
        -:159127:};
        -:159128:
        -:159129:/* This object holds the prerequisites and the cost of running a
        -:159130:** subquery on one operand of an OR operator in the WHERE clause.
        -:159131:** See WhereOrSet for additional information
        -:159132:*/
