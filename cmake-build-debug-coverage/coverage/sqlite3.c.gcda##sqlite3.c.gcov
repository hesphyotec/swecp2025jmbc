        -:70377:  static const u32 aZero[4] = { 0, 0, 0, 0 };
        -:70378:
        -:70379:  assert( pWal->readLock>=0 && pWal->writeLock==0 );
        -:70380:
        -:70381:  if( memcmp(&pWal->hdr.aFrameCksum[0],aZero,16)==0 ){
