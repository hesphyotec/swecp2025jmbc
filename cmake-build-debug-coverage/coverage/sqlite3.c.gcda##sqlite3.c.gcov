        -:159118:# define WHERE_LOOP_XFER_SZ offsetof(WhereLoop,nLSlot)
        -:159119:  u16 nLSlot;           /* Number of slots allocated for aLTerm[] */
        -:159120:#ifdef WHERETRACE_ENABLED
