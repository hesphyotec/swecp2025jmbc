        -:159097:      u16 nBtm;              /* Size of BTM vector */
        -:159098:      u16 nTop;              /* Size of TOP vector */
        -:159099:      u16 nDistinctCol;      /* Index columns used to sort for DISTINCT */
        -:159100:      Index *pIndex;         /* Index used, or NULL */
        -:159101:      ExprList *pOrderBy;    /* ORDER BY clause if this is really a subquery */
        -:159102:    } btree;
        -:159103:    struct {               /* Information for virtual tables */
