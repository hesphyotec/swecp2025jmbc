        -:71175:**               identifies the parent page in the btree.
        -:71176:*/
        -:71177:#define PTRMAP_ROOTPAGE 1
        -:71178:#define PTRMAP_FREEPAGE 2
        -:71179:#define PTRMAP_OVERFLOW1 3
        -:71180:#define PTRMAP_OVERFLOW2 4
        -:71181:#define PTRMAP_BTREE 5
        -:71182:
        -:71183:/* A bunch of assert() statements to check the transaction state variables
        -:71184:** of handle p (type Btree*) are internally consistent.
        -:71185:*/
        -:71186:#define btreeIntegrity(p) \
        -:71187:  assert( p->pBt->inTransaction!=TRANS_NONE || p->pBt->nTransaction==0 ); \
        -:71188:  assert( p->pBt->inTransaction>=p->inTrans );
