        -:70832:  u8 eLock;             /* READ_LOCK or WRITE_LOCK */
        -:70833:  BtLock *pNext;        /* Next in BtShared.pLock list */
        -:70834:};
        -:70835:
        -:70836:/* Candidate values for BtLock.eLock */
        -:70837:#define READ_LOCK     1
        -:70838:#define WRITE_LOCK    2
        -:70839:
        -:70840:/* A Btree handle
        -:70841:**
        -:70842:** A database connection contains a pointer to an instance of
        -:70843:** this object for every database file that it has open.  This structure
        -:70844:** is opaque to the database connection.  The database connection cannot
        -:70845:** see the internals of this structure and only deals with pointers to
        -:70846:** this structure.
        -:70847:**
        -:70848:** For some database files, the same underlying database cache might be
        -:70849:** shared between multiple connections.  In that case, each connection
        -:70850:** has it own instance of this object.  But each instance of this object
        -:70851:** points to the same BtShared object.  The database cache and the
        -:70852:** schema associated with the database file are all contained within
        -:70853:** the BtShared object.
        -:70854:**
        -:70855:** All fields in this structure are accessed under sqlite3.mutex.
        -:70856:** The pBt pointer itself may not be changed while there exists cursors
        -:70857:** in the referenced BtShared that point back to this Btree since those
        -:70858:** cursors have to go through this Btree to find their BtShared and
        -:70859:** they often do so without holding sqlite3.mutex.
        -:70860:*/
        -:70861:struct Btree {
        -:70862:  sqlite3 *db;       /* The database connection holding this btree */
        -:70863:  BtShared *pBt;     /* Sharable content of this btree */
        -:70864:  u8 inTrans;        /* TRANS_NONE, TRANS_READ or TRANS_WRITE */
        -:70865:  u8 sharable;       /* True if we can share pBt with another db */
        -:70866:  u8 locked;         /* True if db currently has pBt locked */
        -:70867:  u8 hasIncrblobCur; /* True if there are one or more Incrblob cursors */
        -:70868:  int wantToLock;    /* Number of nested calls to sqlite3BtreeEnter() */
        -:70869:  int nBackup;       /* Number of backup operations reading this btree */
        -:70870:  u32 iBDataVersion; /* Combines with pBt->pPager->iDataVersion */
        -:70871:  Btree *pNext;      /* List of other sharable Btrees from the same db */
        -:70872:  Btree *pPrev;      /* Back pointer of the same list */
        -:70873:#ifdef SQLITE_DEBUG
        -:70874:  u64 nSeek;         /* Calls to sqlite3BtreeMovetoUnpacked() */
        -:70875:#endif
        -:70876:#ifndef SQLITE_OMIT_SHARED_CACHE
        -:70877:  BtLock lock;       /* Object used to lock page 1 */
        -:70878:#endif
        -:70879:};
