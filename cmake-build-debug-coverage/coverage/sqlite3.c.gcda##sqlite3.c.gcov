        -:18780:  u8 eVtabRisk;             /* Riskiness of allowing hacker access */
        -:18781:  int iSavepoint;           /* Depth of the SAVEPOINT stack */
        -:18782:  VTable *pNext;            /* Next in linked list (see above) */
        -:18783:};
