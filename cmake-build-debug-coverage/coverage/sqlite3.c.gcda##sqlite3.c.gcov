        -:198619:SQLITE_PRIVATE void sqlite3Fts3SimpleTokenizerModule(sqlite3_tokenizer_module const**ppModule);
        -:198620:
        -:198621:/*
        -:198622:** Implementation of the scalar function fts3_tokenizer_internal_test().
        -:198623:** This function is used for testing only, it is not included in the
        -:198624:** build unless SQLITE_TEST is defined.
        -:198625:**
        -:198626:** The purpose of this is to test that the fts3_tokenizer() function
        -:198627:** can be used as designed by the C-code in the queryTokenizer and
        -:198628:** registerTokenizer() functions above. These two functions are repeated
        -:198629:** in the README.tokenizer file as an example, so it is important to
        -:198630:** test them.
        -:198631:**
        -:198632:** To run the tests, evaluate the fts3_tokenizer_internal_test() scalar
        -:198633:** function with no arguments. An assert() will fail if a problem is
        -:198634:** detected. i.e.:
        -:198635:**
        -:198636:**     SELECT fts3_tokenizer_internal_test();
        -:198637:**
        -:198638:*/
        -:198639:static void intTestFunc(
        -:198640:  sqlite3_context *context,
        -:198641:  int argc,
        -:198642:  sqlite3_value **argv
        -:198643:){
        -:198644:  int rc;
        -:198645:  const sqlite3_tokenizer_module *p1;
        -:198646:  const sqlite3_tokenizer_module *p2;
        -:198647:  sqlite3 *db = (sqlite3 *)sqlite3_user_data(context);
        -:198648:
        -:198649:  UNUSED_PARAMETER(argc);
        -:198650:  UNUSED_PARAMETER(argv);
        -:198651:
        -:198652:  /* Test the query function */
        -:198653:  sqlite3Fts3SimpleTokenizerModule(&p1);
        -:198654:  rc = queryTokenizer(db, "simple", &p2);
        -:198655:  assert( rc==SQLITE_OK );
        -:198656:  assert( p1==p2 );
        -:198657:  rc = queryTokenizer(db, "nosuchtokenizer", &p2);
        -:198658:  assert( rc==SQLITE_ERROR );
        -:198659:  assert( p2==0 );
        -:198660:  assert( 0==strcmp(sqlite3_errmsg(db), "unknown tokenizer: nosuchtokenizer") );
        -:198661:
        -:198662:  /* Test the storage function */
        -:198663:  if( fts3TokenizerEnabled(context) ){
        -:198664:    rc = registerTokenizer(db, "nosuchtokenizer", p1);
        -:198665:    assert( rc==SQLITE_OK );
        -:198666:    rc = queryTokenizer(db, "nosuchtokenizer", &p2);
        -:198667:    assert( rc==SQLITE_OK );
        -:198668:    assert( p2==p1 );
        -:198669:  }
        -:198670:
        -:198671:  sqlite3_result_text(context, "ok", -1, SQLITE_STATIC);
        -:198672:}
