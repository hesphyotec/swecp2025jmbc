        -:199119:/*
        -:199120:** Schema of the tokenizer table.
        -:199121:*/
        -:199122:#define FTS3_TOK_SCHEMA "CREATE TABLE x(input, token, start, end, position)"
        -:199123:
        -:199124:/*
        -:199125:** This function does all the work for both the xConnect and xCreate methods.
        -:199126:** These tables have no persistent representation of their own, so xConnect
        -:199127:** and xCreate are identical operations.
        -:199128:**
        -:199129:**   argv[0]: module name
