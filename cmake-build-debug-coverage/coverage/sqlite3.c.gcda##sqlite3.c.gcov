        -:198491:  const char *zInput;
        -:198492:  int nInput;
        -:198493:
        -:198494:  const char *azArg[64];
        -:198495:
        -:198496:  const char *zToken;
        -:198497:  int nToken = 0;
        -:198498:  int iStart = 0;
        -:198499:  int iEnd = 0;
        -:198500:  int iPos = 0;
        -:198501:  int i;
        -:198502:
        -:198503:  Tcl_Obj *pRet;
        -:198504:
        -:198505:  if( argc<2 ){
        -:198506:    sqlite3_result_error(context, "insufficient arguments", -1);
        -:198507:    return;
        -:198508:  }
        -:198509:
        -:198510:  nName = sqlite3_value_bytes(argv[0]);
        -:198511:  zName = (const char *)sqlite3_value_text(argv[0]);
        -:198512:  nInput = sqlite3_value_bytes(argv[argc-1]);
        -:198513:  zInput = (const char *)sqlite3_value_text(argv[argc-1]);
        -:198514:
        -:198515:  pHash = (Fts3Hash *)sqlite3_user_data(context);
        -:198516:  p = (sqlite3_tokenizer_module *)sqlite3Fts3HashFind(pHash, zName, nName+1);
        -:198517:
        -:198518:  if( !p ){
        -:198519:    char *zErr2 = sqlite3_mprintf("unknown tokenizer: %s", zName);
        -:198520:    sqlite3_result_error(context, zErr2, -1);
        -:198521:    sqlite3_free(zErr2);
        -:198522:    return;
        -:198523:  }
        -:198524:
        -:198525:  pRet = Tcl_NewObj();
        -:198526:  Tcl_IncrRefCount(pRet);
        -:198527:
        -:198528:  for(i=1; i<argc-1; i++){
        -:198529:    azArg[i-1] = (const char *)sqlite3_value_text(argv[i]);
        -:198530:  }
        -:198531:
        -:198532:  if( SQLITE_OK!=p->xCreate(argc-2, azArg, &pTokenizer) ){
        -:198533:    zErr = "error in xCreate()";
        -:198534:    goto finish;
        -:198535:  }
        -:198536:  pTokenizer->pModule = p;
        -:198537:  if( sqlite3Fts3OpenTokenizer(pTokenizer, 0, zInput, nInput, &pCsr) ){
