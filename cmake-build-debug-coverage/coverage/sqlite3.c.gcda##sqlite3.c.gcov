        -:197105:    rc = sqlite3Fts3ExprParse(
        -:197106:        pTokenizer, 0, azCol, 0, nCol, nCol, zExpr, nExpr, &pExpr, &zDummy
        -:197107:    );
        -:197108:    assert( rc==SQLITE_OK || pExpr==0 );
        -:197109:    sqlite3_free(zDummy);
        -:197110:  }else{
        -:197111:    rc = fts3ExprParseUnbalanced(
        -:197112:        pTokenizer, 0, azCol, 0, nCol, nCol, zExpr, nExpr, &pExpr
        -:197113:    );
        -:197114:  }
        -:197115:
        -:197116:  if( rc!=SQLITE_OK && rc!=SQLITE_NOMEM ){
        -:197117:    sqlite3_result_error(context, "Error parsing expression", -1);
        -:197118:  }else if( rc==SQLITE_NOMEM || !(zBuf = exprToString(pExpr, 0)) ){
