        -:55185:/*
        -:55186:** A complete page cache is an instance of this structure.  Every
        -:55187:** entry in the cache holds a single page of the database file.  The
        -:55188:** btree layer only operates on the cached copy of the database pages.
        -:55189:**
        -:55190:** A page cache entry is "clean" if it exactly matches what is currently
        -:55191:** on disk.  A page is "dirty" if it has been modified and needs to be
        -:55192:** persisted to disk.
        -:55193:**
        -:55194:** pDirty, pDirtyTail, pSynced:
        -:55195:**   All dirty pages are linked into the doubly linked list using
        -:55196:**   PgHdr.pDirtyNext and pDirtyPrev. The list is maintained in LRU order
        -:55197:**   such that p was added to the list more recently than p->pDirtyNext.
        -:55198:**   PCache.pDirty points to the first (newest) element in the list and
        -:55199:**   pDirtyTail to the last (oldest).
        -:55200:**
        -:55201:**   The PCache.pSynced variable is used to optimize searching for a dirty
        -:55202:**   page to eject from the cache mid-transaction. It is better to eject
        -:55203:**   a page that does not require a journal sync than one that does.
        -:55204:**   Therefore, pSynced is maintained so that it *almost* always points
        -:55205:**   to either the oldest page in the pDirty/pDirtyTail list that has a
        -:55206:**   clear PGHDR_NEED_SYNC flag or to a page that is older than this one
        -:55207:**   (so that the right page to eject can be found by following pDirtyPrev
        -:55208:**   pointers).
        -:55209:*/
        -:55210:struct PCache {
        -:55211:  PgHdr *pDirty, *pDirtyTail;         /* List of dirty pages in LRU order */
        -:55212:  PgHdr *pSynced;                     /* Last synced page in dirty page list */
        -:55213:  i64 nRefSum;                        /* Sum of ref counts over all pages */
        -:55214:  int szCache;                        /* Configured cache size */
        -:55215:  int szSpill;                        /* Size before spilling occurs */
        -:55216:  int szPage;                         /* Size of every page in this cache */
        -:55217:  int szExtra;                        /* Size of extra space for each page */
        -:55218:  u8 bPurgeable;                      /* True if pages are on backing store */
