        -:70400:  sqlite3_snapshot *pSnapshot
        -:70401:){
        -:70402:  if( pSnapshot && ((WalIndexHdr*)pSnapshot)->iVersion==0 ){
        -:70403:    /* iVersion==0 means that this is a call to sqlite3_snapshot_get().  In
        -:70404:    ** this case set the bGetSnapshot flag so that if the call to
        -:70405:    ** sqlite3_snapshot_get() is about to read transaction on this wal
        -:70406:    ** file, it does not take read-lock 0 if the wal file has been completely
        -:70407:    ** checkpointed. Taking read-lock 0 would work, but then it would be
        -:70408:    ** possible for a subsequent writer to destroy the snapshot even while
        -:70409:    ** this connection is holding its read-transaction open. This is contrary
        -:70410:    ** to user expectations, so we avoid it by not taking read-lock 0. */
        -:70411:    pWal->bGetSnapshot = 1;
        -:70412:  }else{
        -:70413:    pWal->pSnapshot = (WalIndexHdr*)pSnapshot;
        -:70414:    pWal->bGetSnapshot = 0;
        -:70415:  }
        -:70416:}
        -:70417:
        -:70418:/*
        -:70419:** Return a +ve value if snapshot p1 is newer than p2. A -ve value if
        -:70420:** p1 is older than p2 and zero if p1 and p2 are the same snapshot.
        -:70421:*/
        -:70422:SQLITE_API int sqlite3_snapshot_cmp(sqlite3_snapshot *p1, sqlite3_snapshot *p2){
        -:70423:  WalIndexHdr *pHdr1 = (WalIndexHdr*)p1;
