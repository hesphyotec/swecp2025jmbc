        -:57389:/************** Begin file rowset.c ******************************************/
        -:57390:/*
        -:57391:** 2008 December 3
        -:57392:**
        -:57393:** The author disclaims copyright to this source code.  In place of
        -:57394:** a legal notice, here is a blessing:
        -:57395:**
        -:57396:**    May you do good and not evil.
        -:57397:**    May you find forgiveness for yourself and forgive others.
        -:57398:**    May you share freely, never taking more than you give.
        -:57399:**
        -:57400:*************************************************************************
        -:57401:**
        -:57402:** This module implements an object we call a "RowSet".
        -:57403:**
        -:57404:** The RowSet object is a collection of rowids.  Rowids
        -:57405:** are inserted into the RowSet in an arbitrary order.  Inserts
        -:57406:** can be intermixed with tests to see if a given rowid has been
        -:57407:** previously inserted into the RowSet.
        -:57408:**
        -:57409:** After all inserts are finished, it is possible to extract the
        -:57410:** elements of the RowSet in sorted order.  Once this extraction
        -:57411:** process has started, no new elements may be inserted.
        -:57412:**
        -:57413:** Hence, the primitive operations for a RowSet are:
        -:57414:**
        -:57415:**    CREATE
        -:57416:**    INSERT
        -:57417:**    TEST
        -:57418:**    SMALLEST
        -:57419:**    DESTROY
        -:57420:**
        -:57421:** The CREATE and DESTROY primitives are the constructor and destructor,
        -:57422:** obviously.  The INSERT primitive adds a new element to the RowSet.
        -:57423:** TEST checks to see if an element is already in the RowSet.  SMALLEST
        -:57424:** extracts the least value from the RowSet.
        -:57425:**
        -:57426:** The INSERT primitive might allocate additional memory.  Memory is
        -:57427:** allocated in chunks so most INSERTs do no allocation.  There is an
        -:57428:** upper bound on the size of allocated memory.  No memory is freed
        -:57429:** until DESTROY.
        -:57430:**
        -:57431:** The TEST primitive includes a "batch" number.  The TEST primitive
        -:57432:** will only see elements that were inserted before the last change
        -:57433:** in the batch number.  In other words, if an INSERT occurs between
        -:57434:** two TESTs where the TESTs have the same batch number, then the
        -:57435:** value added by the INSERT will not be visible to the second TEST.
        -:57436:** The initial batch number is zero, so if the very first TEST contains
        -:57437:** a non-zero batch number, it will see all prior INSERTs.
        -:57438:**
        -:57439:** No INSERTs may occurs after a SMALLEST.  An assertion will fail if
        -:57440:** that is attempted.
        -:57441:**
        -:57442:** The cost of an INSERT is roughly constant.  (Sometimes new memory
        -:57443:** has to be allocated on an INSERT.)  The cost of a TEST with a new
        -:57444:** batch number is O(NlogN) where N is the number of elements in the RowSet.
        -:57445:** The cost of a TEST using the same batch number is O(logN).  The cost
        -:57446:** of the first SMALLEST is O(NlogN).  Second and subsequent SMALLEST
        -:57447:** primitives are constant time.  The cost of DESTROY is O(N).
        -:57448:**
        -:57449:** TEST and SMALLEST may not be used by the same RowSet.  This used to
        -:57450:** be possible, but the feature was not used, so it was removed in order
        -:57451:** to simplify the code.
        -:57452:*/
        -:57453:/* #include "sqliteInt.h" */
        -:57454:
        -:57455:
        -:57456:/*
        -:57457:** Target size for allocation chunks.
        -:57458:*/
        -:57459:#define ROWSET_ALLOCATION_SIZE 1024
        -:57460:
        -:57461:/*
        -:57462:** The number of rowset entries per allocation chunk.
        -:57463:*/
        -:57464:#define ROWSET_ENTRY_PER_CHUNK  \
        -:57465:                       ((ROWSET_ALLOCATION_SIZE-8)/sizeof(struct RowSetEntry))
        -:57466:
        -:57467:/*
        -:57468:** Each entry in a RowSet is an instance of the following object.
        -:57469:**
        -:57470:** This same object is reused to store a linked list of trees of RowSetEntry
        -:57471:** objects.  In that alternative use, pRight points to the next entry
        -:57472:** in the list, pLeft points to the tree, and v is unused.  The
        -:57473:** RowSet.pForest value points to the head of this forest list.
        -:57474:*/
        -:57475:struct RowSetEntry {
        -:57476:  i64 v;                        /* ROWID value for this entry */
        -:57477:  struct RowSetEntry *pRight;   /* Right subtree (larger entries) or list */
        -:57478:  struct RowSetEntry *pLeft;    /* Left subtree (smaller entries) */
        -:57479:};
        -:57480:
        -:57481:/*
        -:57482:** RowSetEntry objects are allocated in large chunks (instances of the
        -:57483:** following structure) to reduce memory allocation overhead.  The
        -:57484:** chunks are kept on a linked list so that they can be deallocated
        -:57485:** when the RowSet is destroyed.
        -:57486:*/
        -:57487:struct RowSetChunk {
        -:57488:  struct RowSetChunk *pNextChunk;        /* Next chunk on list of them all */
        -:57489:  struct RowSetEntry aEntry[ROWSET_ENTRY_PER_CHUNK]; /* Allocated entries */
        -:57490:};
        -:57491:
        -:57492:/*
        -:57493:** A RowSet in an instance of the following structure.
        -:57494:**
        -:57495:** A typedef of this structure if found in sqliteInt.h.
        -:57496:*/
        -:57497:struct RowSet {
