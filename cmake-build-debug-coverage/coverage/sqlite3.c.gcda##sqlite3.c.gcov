        -:70892:#define TRANS_READ  1
        -:70893:#define TRANS_WRITE 2
        -:70894:
        -:70895:#if TRANS_NONE!=SQLITE_TXN_NONE
        -:70896:# error wrong numeric code for no-transaction
        -:70897:#endif
        -:70898:#if TRANS_READ!=SQLITE_TXN_READ
        -:70899:# error wrong numeric code for read-transaction
        -:70900:#endif
        -:70901:#if TRANS_WRITE!=SQLITE_TXN_WRITE
        -:70902:# error wrong numeric code for write-transaction
        -:70903:#endif
        -:70904:
        -:70905:
        -:70906:/*
        -:70907:** An instance of this object represents a single database file.
        -:70908:**
        -:70909:** A single database file can be in use at the same time by two
        -:70910:** or more database connections.  When two or more connections are
        -:70911:** sharing the same database file, each connection has it own
        -:70912:** private Btree object for the file and each of those Btrees points
        -:70913:** to this one BtShared object.  BtShared.nRef is the number of
        -:70914:** connections currently sharing this database file.
        -:70915:**
        -:70916:** Fields in this structure are accessed under the BtShared.mutex
        -:70917:** mutex, except for nRef and pNext which are accessed under the
        -:70918:** global SQLITE_MUTEX_STATIC_MAIN mutex.  The pPager field
        -:70919:** may not be modified once it is initially set as long as nRef>0.
        -:70920:** The pSchema field may be set once under BtShared.mutex and
        -:70921:** thereafter is unchanged as long as nRef>0.
        -:70922:**
        -:70923:** isPending:
        -:70924:**
        -:70925:**   If a BtShared client fails to obtain a write-lock on a database
        -:70926:**   table (because there exists one or more read-locks on the table),
        -:70927:**   the shared-cache enters 'pending-lock' state and isPending is
        -:70928:**   set to true.
        -:70929:**
        -:70930:**   The shared-cache leaves the 'pending lock' state when either of
        -:70931:**   the following occur:
        -:70932:**
        -:70933:**     1) The current writer (BtShared.pWriter) concludes its transaction, OR
        -:70934:**     2) The number of locks held by other connections drops to zero.
        -:70935:**
        -:70936:**   while in the 'pending-lock' state, no connection may start a new
        -:70937:**   transaction.
        -:70938:**
        -:70939:**   This feature is included to help prevent writer-starvation.
        -:70940:*/
        -:70941:struct BtShared {
        -:70942:  Pager *pPager;        /* The page cache */
        -:70943:  sqlite3 *db;          /* Database connection currently using this Btree */
        -:70944:  BtCursor *pCursor;    /* A list of all open cursors */
        -:70945:  MemPage *pPage1;      /* First page of the database */
        -:70946:  u8 openFlags;         /* Flags to sqlite3BtreeOpen() */
        -:70947:#ifndef SQLITE_OMIT_AUTOVACUUM
        -:70948:  u8 autoVacuum;        /* True if auto-vacuum is enabled */
        -:70949:  u8 incrVacuum;        /* True if incr-vacuum is enabled */
        -:70950:  u8 bDoTruncate;       /* True to truncate db on commit */
        -:70951:#endif
        -:70952:  u8 inTransaction;     /* Transaction state */
        -:70953:  u8 max1bytePayload;   /* Maximum first byte of cell for a 1-byte payload */
        -:70954:  u8 nReserveWanted;    /* Desired number of extra bytes per page */
        -:70955:  u16 btsFlags;         /* Boolean parameters.  See BTS_* macros below */
        -:70956:  u16 maxLocal;         /* Maximum local payload in non-LEAFDATA tables */
        -:70957:  u16 minLocal;         /* Minimum local payload in non-LEAFDATA tables */
        -:70958:  u16 maxLeaf;          /* Maximum local payload in a LEAFDATA table */
        -:70959:  u16 minLeaf;          /* Minimum local payload in a LEAFDATA table */
        -:70960:  u32 pageSize;         /* Total number of bytes on a page */
        -:70961:  u32 usableSize;       /* Number of usable bytes on each page */
        -:70962:  int nTransaction;     /* Number of open transactions (read + write) */
        -:70963:  u32 nPage;            /* Number of pages in the database */
        -:70964:  void *pSchema;        /* Pointer to space allocated by sqlite3BtreeSchema() */
        -:70965:  void (*xFreeSchema)(void*);  /* Destructor for BtShared.pSchema */
        -:70966:  sqlite3_mutex *mutex; /* Non-recursive mutex required to access this object */
        -:70967:  Bitvec *pHasContent;  /* Set of pages moved to free-list this transaction */
        -:70968:#ifndef SQLITE_OMIT_SHARED_CACHE
        -:70969:  int nRef;             /* Number of references to this structure */
        -:70970:  BtShared *pNext;      /* Next on a list of sharable BtShared structs */
        -:70971:  BtLock *pLock;        /* List of locks held on this shared-btree struct */
        -:70972:  Btree *pWriter;       /* Btree with currently open write transaction */
        -:70973:#endif
        -:70974:  u8 *pTmpSpace;        /* Temp space sufficient to hold a single cell */
        -:70975:  int nPreformatSize;   /* Size of last cell written by TransferRow() */
        -:70976:};
        -:70977:
        -:70978:/*
        -:70979:** Allowed values for BtShared.btsFlags
        -:70980:*/
        -:70981:#define BTS_READ_ONLY        0x0001   /* Underlying file is readonly */
        -:70982:#define BTS_PAGESIZE_FIXED   0x0002   /* Page size can no longer be changed */
        -:70983:#define BTS_SECURE_DELETE    0x0004   /* PRAGMA secure_delete is enabled */
        -:70984:#define BTS_OVERWRITE        0x0008   /* Overwrite deleted content with zeros */
