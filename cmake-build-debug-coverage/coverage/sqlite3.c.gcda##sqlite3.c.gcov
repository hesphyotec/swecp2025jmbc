        -:221515:
        -:221516:/*
        -:221517:** An iterator of this type is used to iterate through all objects in
        -:221518:** the target database that require updating. For each such table, the
        -:221519:** iterator visits, in order:
        -:221520:**
        -:221521:**     * the table itself,
        -:221522:**     * each index of the table (zero or more points to visit), and
        -:221523:**     * a special "cleanup table" state.
        -:221524:**
        -:221525:** abIndexed:
        -:221526:**   If the table has no indexes on it, abIndexed is set to NULL. Otherwise,
        -:221527:**   it points to an array of flags nTblCol elements in size. The flag is
        -:221528:**   set for each column that is either a part of the PK or a part of an
        -:221529:**   index. Or clear otherwise.
        -:221530:**
        -:221531:**   If there are one or more partial indexes on the table, all fields of
        -:221532:**   this array set set to 1. This is because in that case, the module has
        -:221533:**   no way to tell which fields will be required to add and remove entries
        -:221534:**   from the partial indexes.
        -:221535:**
        -:221536:*/
        -:221537:struct RbuObjIter {
        -:221538:  sqlite3_stmt *pTblIter;         /* Iterate through tables */
        -:221539:  sqlite3_stmt *pIdxIter;         /* Index iterator */
        -:221540:  int nTblCol;                    /* Size of azTblCol[] array */
        -:221541:  char **azTblCol;                /* Array of unquoted target column names */
        -:221542:  char **azTblType;               /* Array of target column types */
        -:221543:  int *aiSrcOrder;                /* src table col -> target table col */
        -:221544:  u8 *abTblPk;                    /* Array of flags, set on target PK columns */
        -:221545:  u8 *abNotNull;                  /* Array of flags, set on NOT NULL columns */
        -:221546:  u8 *abIndexed;                  /* Array of flags, set on indexed & PK cols */
        -:221547:  int eType;                      /* Table type - an RBU_PK_XXX value */
        -:221548:
        -:221549:  /* Output variables. zTbl==0 implies EOF. */
        -:221550:  int bCleanup;                   /* True in "cleanup" state */
        -:221551:  const char *zTbl;               /* Name of target db table */
        -:221552:  const char *zDataTbl;           /* Name of rbu db table (or null) */
        -:221553:  const char *zIdx;               /* Name of target db index (or null) */
        -:221554:  int iTnum;                      /* Root page of current object */
        -:221555:  int iPkTnum;                    /* If eType==EXTERNAL, root of PK index */
        -:221556:  int bUnique;                    /* Current index is unique */
        -:221557:  int nIndex;                     /* Number of aux. indexes on table zTbl */
        -:221558:
        -:221559:  /* Statements created by rbuObjIterPrepareAll() */
        -:221560:  int nCol;                       /* Number of columns in current object */
        -:221561:  sqlite3_stmt *pSelect;          /* Source data */
        -:221562:  sqlite3_stmt *pInsert;          /* Statement for INSERT operations */
        -:221563:  sqlite3_stmt *pDelete;          /* Statement for DELETE ops */
        -:221564:  sqlite3_stmt *pTmpInsert;       /* Insert into rbu_tmp_$zDataTbl */
        -:221565:  int nIdxCol;
        -:221566:  RbuSpan *aIdxCol;
        -:221567:  char *zIdxSql;
        -:221568:
        -:221569:  /* Last UPDATE used (for PK b-tree updates only), or NULL. */
        -:221570:  RbuUpdateStmt *pRbuUpdate;
        -:221571:};
        -:221572:
        -:221573:/*
        -:221574:** Values for RbuObjIter.eType
        -:221575:**
        -:221576:**     0: Table does not exist (error)
        -:221577:**     1: Table has an implicit rowid.
        -:221578:**     2: Table has an explicit IPK column.
        -:221579:**     3: Table has an external PK index.
        -:221580:**     4: Table is WITHOUT ROWID.
        -:221581:**     5: Table is a virtual table.
        -:221582:*/
        -:221583:#define RBU_PK_NOTABLE        0
        -:221584:#define RBU_PK_NONE           1
        -:221585:#define RBU_PK_IPK            2
        -:221586:#define RBU_PK_EXTERNAL       3
        -:221587:#define RBU_PK_WITHOUT_ROWID  4
