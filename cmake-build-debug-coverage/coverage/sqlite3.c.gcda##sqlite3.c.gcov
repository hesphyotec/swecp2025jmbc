        -:234808:
        -:234809:#ifndef _FTS5_H
        -:234810:#define _FTS5_H
        -:234811:
        -:234812:/* #include "sqlite3.h" */
        -:234813:
        -:234814:#if 0
        -:234815:extern "C" {
        -:234816:#endif
        -:234817:
        -:234818:/*************************************************************************
        -:234819:** CUSTOM AUXILIARY FUNCTIONS
        -:234820:**
        -:234821:** Virtual table implementations may overload SQL functions by implementing
        -:234822:** the sqlite3_module.xFindFunction() method.
        -:234823:*/
        -:234824:
        -:234825:typedef struct Fts5ExtensionApi Fts5ExtensionApi;
        -:234826:typedef struct Fts5Context Fts5Context;
        -:234827:typedef struct Fts5PhraseIter Fts5PhraseIter;
        -:234828:
        -:234829:typedef void (*fts5_extension_function)(
        -:234830:  const Fts5ExtensionApi *pApi,   /* API offered by current FTS version */
        -:234831:  Fts5Context *pFts,              /* First arg to pass to pApi functions */
        -:234832:  sqlite3_context *pCtx,          /* Context for returning result/error */
        -:234833:  int nVal,                       /* Number of values in apVal[] array */
        -:234834:  sqlite3_value **apVal           /* Array of trailing arguments */
        -:234835:);
        -:234836:
        -:234837:struct Fts5PhraseIter {
        -:234838:  const unsigned char *a;
        -:234839:  const unsigned char *b;
        -:234840:};
        -:234841:
        -:234842:/*
        -:234843:** EXTENSION API FUNCTIONS
        -:234844:**
        -:234845:** xUserData(pFts):
        -:234846:**   Return a copy of the pUserData pointer passed to the xCreateFunction()
        -:234847:**   API when the extension function was registered.
        -:234848:**
        -:234849:** xColumnTotalSize(pFts, iCol, pnToken):
        -:234850:**   If parameter iCol is less than zero, set output variable *pnToken
        -:234851:**   to the total number of tokens in the FTS5 table. Or, if iCol is
        -:234852:**   non-negative but less than the number of columns in the table, return
        -:234853:**   the total number of tokens in column iCol, considering all rows in
        -:234854:**   the FTS5 table.
        -:234855:**
        -:234856:**   If parameter iCol is greater than or equal to the number of columns
        -:234857:**   in the table, SQLITE_RANGE is returned. Or, if an error occurs (e.g.
        -:234858:**   an OOM condition or IO error), an appropriate SQLite error code is
        -:234859:**   returned.
        -:234860:**
        -:234861:** xColumnCount(pFts):
        -:234862:**   Return the number of columns in the table.
        -:234863:**
        -:234864:** xColumnSize(pFts, iCol, pnToken):
        -:234865:**   If parameter iCol is less than zero, set output variable *pnToken
        -:234866:**   to the total number of tokens in the current row. Or, if iCol is
        -:234867:**   non-negative but less than the number of columns in the table, set
        -:234868:**   *pnToken to the number of tokens in column iCol of the current row.
        -:234869:**
        -:234870:**   If parameter iCol is greater than or equal to the number of columns
        -:234871:**   in the table, SQLITE_RANGE is returned. Or, if an error occurs (e.g.
        -:234872:**   an OOM condition or IO error), an appropriate SQLite error code is
        -:234873:**   returned.
        -:234874:**
        -:234875:**   This function may be quite inefficient if used with an FTS5 table
        -:234876:**   created with the "columnsize=0" option.
        -:234877:**
        -:234878:** xColumnText:
        -:234879:**   If parameter iCol is less than zero, or greater than or equal to the
        -:234880:**   number of columns in the table, SQLITE_RANGE is returned.
        -:234881:**
        -:234882:**   Otherwise, this function attempts to retrieve the text of column iCol of
        -:234883:**   the current document. If successful, (*pz) is set to point to a buffer
        -:234884:**   containing the text in utf-8 encoding, (*pn) is set to the size in bytes
        -:234885:**   (not characters) of the buffer and SQLITE_OK is returned. Otherwise,
        -:234886:**   if an error occurs, an SQLite error code is returned and the final values
        -:234887:**   of (*pz) and (*pn) are undefined.
        -:234888:**
        -:234889:** xPhraseCount:
        -:234890:**   Returns the number of phrases in the current query expression.
        -:234891:**
        -:234892:** xPhraseSize:
        -:234893:**   If parameter iCol is less than zero, or greater than or equal to the
        -:234894:**   number of phrases in the current query, as returned by xPhraseCount,
        -:234895:**   0 is returned. Otherwise, this function returns the number of tokens in
        -:234896:**   phrase iPhrase of the query. Phrases are numbered starting from zero.
        -:234897:**
        -:234898:** xInstCount:
        -:234899:**   Set *pnInst to the total number of occurrences of all phrases within
        -:234900:**   the query within the current row. Return SQLITE_OK if successful, or
        -:234901:**   an error code (i.e. SQLITE_NOMEM) if an error occurs.
        -:234902:**
        -:234903:**   This API can be quite slow if used with an FTS5 table created with the
        -:234904:**   "detail=none" or "detail=column" option. If the FTS5 table is created
        -:234905:**   with either "detail=none" or "detail=column" and "content=" option
        -:234906:**   (i.e. if it is a contentless table), then this API always returns 0.
        -:234907:**
        -:234908:** xInst:
        -:234909:**   Query for the details of phrase match iIdx within the current row.
        -:234910:**   Phrase matches are numbered starting from zero, so the iIdx argument
        -:234911:**   should be greater than or equal to zero and smaller than the value
        -:234912:**   output by xInstCount(). If iIdx is less than zero or greater than
        -:234913:**   or equal to the value returned by xInstCount(), SQLITE_RANGE is returned.
        -:234914:**
        -:234915:**   Otherwise, output parameter *piPhrase is set to the phrase number, *piCol
        -:234916:**   to the column in which it occurs and *piOff the token offset of the
        -:234917:**   first token of the phrase. SQLITE_OK is returned if successful, or an
        -:234918:**   error code (i.e. SQLITE_NOMEM) if an error occurs.
        -:234919:**
        -:234920:**   This API can be quite slow if used with an FTS5 table created with the
        -:234921:**   "detail=none" or "detail=column" option.
        -:234922:**
        -:234923:** xRowid:
        -:234924:**   Returns the rowid of the current row.
        -:234925:**
        -:234926:** xTokenize:
        -:234927:**   Tokenize text using the tokenizer belonging to the FTS5 table.
        -:234928:**
        -:234929:** xQueryPhrase(pFts5, iPhrase, pUserData, xCallback):
        -:234930:**   This API function is used to query the FTS table for phrase iPhrase
        -:234931:**   of the current query. Specifically, a query equivalent to:
        -:234932:**
        -:234933:**       ... FROM ftstable WHERE ftstable MATCH $p ORDER BY rowid
        -:234934:**
        -:234935:**   with $p set to a phrase equivalent to the phrase iPhrase of the
        -:234936:**   current query is executed. Any column filter that applies to
        -:234937:**   phrase iPhrase of the current query is included in $p. For each
        -:234938:**   row visited, the callback function passed as the fourth argument
        -:234939:**   is invoked. The context and API objects passed to the callback
        -:234940:**   function may be used to access the properties of each matched row.
        -:234941:**   Invoking Api.xUserData() returns a copy of the pointer passed as
        -:234942:**   the third argument to pUserData.
        -:234943:**
        -:234944:**   If parameter iPhrase is less than zero, or greater than or equal to
        -:234945:**   the number of phrases in the query, as returned by xPhraseCount(),
        -:234946:**   this function returns SQLITE_RANGE.
        -:234947:**
        -:234948:**   If the callback function returns any value other than SQLITE_OK, the
        -:234949:**   query is abandoned and the xQueryPhrase function returns immediately.
        -:234950:**   If the returned value is SQLITE_DONE, xQueryPhrase returns SQLITE_OK.
        -:234951:**   Otherwise, the error code is propagated upwards.
        -:234952:**
        -:234953:**   If the query runs to completion without incident, SQLITE_OK is returned.
        -:234954:**   Or, if some error occurs before the query completes or is aborted by
        -:234955:**   the callback, an SQLite error code is returned.
        -:234956:**
        -:234957:**
        -:234958:** xSetAuxdata(pFts5, pAux, xDelete)
        -:234959:**
        -:234960:**   Save the pointer passed as the second argument as the extension function's
        -:234961:**   "auxiliary data". The pointer may then be retrieved by the current or any
        -:234962:**   future invocation of the same fts5 extension function made as part of
        -:234963:**   the same MATCH query using the xGetAuxdata() API.
        -:234964:**
        -:234965:**   Each extension function is allocated a single auxiliary data slot for
        -:234966:**   each FTS query (MATCH expression). If the extension function is invoked
        -:234967:**   more than once for a single FTS query, then all invocations share a
        -:234968:**   single auxiliary data context.
        -:234969:**
        -:234970:**   If there is already an auxiliary data pointer when this function is
        -:234971:**   invoked, then it is replaced by the new pointer. If an xDelete callback
        -:234972:**   was specified along with the original pointer, it is invoked at this
        -:234973:**   point.
        -:234974:**
        -:234975:**   The xDelete callback, if one is specified, is also invoked on the
        -:234976:**   auxiliary data pointer after the FTS5 query has finished.
        -:234977:**
        -:234978:**   If an error (e.g. an OOM condition) occurs within this function,
        -:234979:**   the auxiliary data is set to NULL and an error code returned. If the
        -:234980:**   xDelete parameter was not NULL, it is invoked on the auxiliary data
        -:234981:**   pointer before returning.
        -:234982:**
        -:234983:**
        -:234984:** xGetAuxdata(pFts5, bClear)
        -:234985:**
        -:234986:**   Returns the current auxiliary data pointer for the fts5 extension
        -:234987:**   function. See the xSetAuxdata() method for details.
        -:234988:**
        -:234989:**   If the bClear argument is non-zero, then the auxiliary data is cleared
        -:234990:**   (set to NULL) before this function returns. In this case the xDelete,
        -:234991:**   if any, is not invoked.
        -:234992:**
        -:234993:**
        -:234994:** xRowCount(pFts5, pnRow)
        -:234995:**
        -:234996:**   This function is used to retrieve the total number of rows in the table.
        -:234997:**   In other words, the same value that would be returned by:
        -:234998:**
        -:234999:**        SELECT count(*) FROM ftstable;
        -:235000:**
        -:235001:** xPhraseFirst()
        -:235002:**   This function is used, along with type Fts5PhraseIter and the xPhraseNext
        -:235003:**   method, to iterate through all instances of a single query phrase within
        -:235004:**   the current row. This is the same information as is accessible via the
        -:235005:**   xInstCount/xInst APIs. While the xInstCount/xInst APIs are more convenient
        -:235006:**   to use, this API may be faster under some circumstances. To iterate
        -:235007:**   through instances of phrase iPhrase, use the following code:
        -:235008:**
        -:235009:**       Fts5PhraseIter iter;
        -:235010:**       int iCol, iOff;
        -:235011:**       for(pApi->xPhraseFirst(pFts, iPhrase, &iter, &iCol, &iOff);
        -:235012:**           iCol>=0;
        -:235013:**           pApi->xPhraseNext(pFts, &iter, &iCol, &iOff)
        -:235014:**       ){
        -:235015:**         // An instance of phrase iPhrase at offset iOff of column iCol
        -:235016:**       }
        -:235017:**
        -:235018:**   The Fts5PhraseIter structure is defined above. Applications should not
        -:235019:**   modify this structure directly - it should only be used as shown above
        -:235020:**   with the xPhraseFirst() and xPhraseNext() API methods (and by
        -:235021:**   xPhraseFirstColumn() and xPhraseNextColumn() as illustrated below).
        -:235022:**
        -:235023:**   This API can be quite slow if used with an FTS5 table created with the
        -:235024:**   "detail=none" or "detail=column" option. If the FTS5 table is created
        -:235025:**   with either "detail=none" or "detail=column" and "content=" option
        -:235026:**   (i.e. if it is a contentless table), then this API always iterates
        -:235027:**   through an empty set (all calls to xPhraseFirst() set iCol to -1).
        -:235028:**
        -:235029:**   In all cases, matches are visited in (column ASC, offset ASC) order.
        -:235030:**   i.e. all those in column 0, sorted by offset, followed by those in
        -:235031:**   column 1, etc.
        -:235032:**
        -:235033:** xPhraseNext()
        -:235034:**   See xPhraseFirst above.
        -:235035:**
        -:235036:** xPhraseFirstColumn()
        -:235037:**   This function and xPhraseNextColumn() are similar to the xPhraseFirst()
        -:235038:**   and xPhraseNext() APIs described above. The difference is that instead
        -:235039:**   of iterating through all instances of a phrase in the current row, these
        -:235040:**   APIs are used to iterate through the set of columns in the current row
        -:235041:**   that contain one or more instances of a specified phrase. For example:
        -:235042:**
        -:235043:**       Fts5PhraseIter iter;
        -:235044:**       int iCol;
        -:235045:**       for(pApi->xPhraseFirstColumn(pFts, iPhrase, &iter, &iCol);
        -:235046:**           iCol>=0;
        -:235047:**           pApi->xPhraseNextColumn(pFts, &iter, &iCol)
        -:235048:**       ){
        -:235049:**         // Column iCol contains at least one instance of phrase iPhrase
        -:235050:**       }
        -:235051:**
        -:235052:**   This API can be quite slow if used with an FTS5 table created with the
        -:235053:**   "detail=none" option. If the FTS5 table is created with either
        -:235054:**   "detail=none" "content=" option (i.e. if it is a contentless table),
        -:235055:**   then this API always iterates through an empty set (all calls to
        -:235056:**   xPhraseFirstColumn() set iCol to -1).
        -:235057:**
        -:235058:**   The information accessed using this API and its companion
        -:235059:**   xPhraseFirstColumn() may also be obtained using xPhraseFirst/xPhraseNext
        -:235060:**   (or xInst/xInstCount). The chief advantage of this API is that it is
        -:235061:**   significantly more efficient than those alternatives when used with
        -:235062:**   "detail=column" tables.
        -:235063:**
        -:235064:** xPhraseNextColumn()
        -:235065:**   See xPhraseFirstColumn above.
        -:235066:**
        -:235067:** xQueryToken(pFts5, iPhrase, iToken, ppToken, pnToken)
        -:235068:**   This is used to access token iToken of phrase iPhrase of the current
        -:235069:**   query. Before returning, output parameter *ppToken is set to point
        -:235070:**   to a buffer containing the requested token, and *pnToken to the
        -:235071:**   size of this buffer in bytes.
        -:235072:**
        -:235073:**   If iPhrase or iToken are less than zero, or if iPhrase is greater than
        -:235074:**   or equal to the number of phrases in the query as reported by
        -:235075:**   xPhraseCount(), or if iToken is equal to or greater than the number of
        -:235076:**   tokens in the phrase, SQLITE_RANGE is returned and *ppToken and *pnToken
        -:235077:     are both zeroed.
        -:235078:**
        -:235079:**   The output text is not a copy of the query text that specified the
        -:235080:**   token. It is the output of the tokenizer module. For tokendata=1
        -:235081:**   tables, this includes any embedded 0x00 and trailing data.
        -:235082:**
        -:235083:** xInstToken(pFts5, iIdx, iToken, ppToken, pnToken)
        -:235084:**   This is used to access token iToken of phrase hit iIdx within the
        -:235085:**   current row. If iIdx is less than zero or greater than or equal to the
        -:235086:**   value returned by xInstCount(), SQLITE_RANGE is returned.  Otherwise,
        -:235087:**   output variable (*ppToken) is set to point to a buffer containing the
        -:235088:**   matching document token, and (*pnToken) to the size of that buffer in
        -:235089:**   bytes.
        -:235090:**
        -:235091:**   The output text is not a copy of the document text that was tokenized.
        -:235092:**   It is the output of the tokenizer module. For tokendata=1 tables, this
        -:235093:**   includes any embedded 0x00 and trailing data.
        -:235094:**
        -:235095:**   This API may be slow in some cases if the token identified by parameters
        -:235096:**   iIdx and iToken matched a prefix token in the query. In most cases, the
        -:235097:**   first call to this API for each prefix token in the query is forced
        -:235098:**   to scan the portion of the full-text index that matches the prefix
        -:235099:**   token to collect the extra data required by this API. If the prefix
        -:235100:**   token matches a large number of token instances in the document set,
        -:235101:**   this may be a performance problem.
        -:235102:**
        -:235103:**   If the user knows in advance that a query may use this API for a
        -:235104:**   prefix token, FTS5 may be configured to collect all required data as part
        -:235105:**   of the initial querying of the full-text index, avoiding the second scan
        -:235106:**   entirely. This also causes prefix queries that do not use this API to
        -:235107:**   run more slowly and use more memory. FTS5 may be configured in this way
        -:235108:**   either on a per-table basis using the [FTS5 insttoken | 'insttoken']
        -:235109:**   option, or on a per-query basis using the
        -:235110:**   [fts5_insttoken | fts5_insttoken()] user function.
        -:235111:**
        -:235112:**   This API can be quite slow if used with an FTS5 table created with the
        -:235113:**   "detail=none" or "detail=column" option.
        -:235114:**
        -:235115:** xColumnLocale(pFts5, iIdx, pzLocale, pnLocale)
        -:235116:**   If parameter iCol is less than zero, or greater than or equal to the
        -:235117:**   number of columns in the table, SQLITE_RANGE is returned.
        -:235118:**
        -:235119:**   Otherwise, this function attempts to retrieve the locale associated
        -:235120:**   with column iCol of the current row. Usually, there is no associated
        -:235121:**   locale, and output parameters (*pzLocale) and (*pnLocale) are set
        -:235122:**   to NULL and 0, respectively. However, if the fts5_locale() function
        -:235123:**   was used to associate a locale with the value when it was inserted
        -:235124:**   into the fts5 table, then (*pzLocale) is set to point to a nul-terminated
        -:235125:**   buffer containing the name of the locale in utf-8 encoding. (*pnLocale)
        -:235126:**   is set to the size in bytes of the buffer, not including the
        -:235127:**   nul-terminator.
        -:235128:**
        -:235129:**   If successful, SQLITE_OK is returned. Or, if an error occurs, an
        -:235130:**   SQLite error code is returned. The final value of the output parameters
        -:235131:**   is undefined in this case.
        -:235132:**
        -:235133:** xTokenize_v2:
        -:235134:**   Tokenize text using the tokenizer belonging to the FTS5 table. This
        -:235135:**   API is the same as the xTokenize() API, except that it allows a tokenizer
        -:235136:**   locale to be specified.
        -:235137:*/
        -:235138:struct Fts5ExtensionApi {
        -:235139:  int iVersion;                   /* Currently always set to 4 */
        -:235140:
        -:235141:  void *(*xUserData)(Fts5Context*);
        -:235142:
        -:235143:  int (*xColumnCount)(Fts5Context*);
        -:235144:  int (*xRowCount)(Fts5Context*, sqlite3_int64 *pnRow);
        -:235145:  int (*xColumnTotalSize)(Fts5Context*, int iCol, sqlite3_int64 *pnToken);
        -:235146:
        -:235147:  int (*xTokenize)(Fts5Context*,
        -:235148:    const char *pText, int nText, /* Text to tokenize */
        -:235149:    void *pCtx,                   /* Context passed to xToken() */
        -:235150:    int (*xToken)(void*, int, const char*, int, int, int)       /* Callback */
        -:235151:  );
        -:235152:
        -:235153:  int (*xPhraseCount)(Fts5Context*);
        -:235154:  int (*xPhraseSize)(Fts5Context*, int iPhrase);
        -:235155:
        -:235156:  int (*xInstCount)(Fts5Context*, int *pnInst);
        -:235157:  int (*xInst)(Fts5Context*, int iIdx, int *piPhrase, int *piCol, int *piOff);
        -:235158:
        -:235159:  sqlite3_int64 (*xRowid)(Fts5Context*);
        -:235160:  int (*xColumnText)(Fts5Context*, int iCol, const char **pz, int *pn);
        -:235161:  int (*xColumnSize)(Fts5Context*, int iCol, int *pnToken);
        -:235162:
        -:235163:  int (*xQueryPhrase)(Fts5Context*, int iPhrase, void *pUserData,
        -:235164:    int(*)(const Fts5ExtensionApi*,Fts5Context*,void*)
        -:235165:  );
        -:235166:  int (*xSetAuxdata)(Fts5Context*, void *pAux, void(*xDelete)(void*));
        -:235167:  void *(*xGetAuxdata)(Fts5Context*, int bClear);
        -:235168:
        -:235169:  int (*xPhraseFirst)(Fts5Context*, int iPhrase, Fts5PhraseIter*, int*, int*);
        -:235170:  void (*xPhraseNext)(Fts5Context*, Fts5PhraseIter*, int *piCol, int *piOff);
        -:235171:
        -:235172:  int (*xPhraseFirstColumn)(Fts5Context*, int iPhrase, Fts5PhraseIter*, int*);
        -:235173:  void (*xPhraseNextColumn)(Fts5Context*, Fts5PhraseIter*, int *piCol);
        -:235174:
        -:235175:  /* Below this point are iVersion>=3 only */
        -:235176:  int (*xQueryToken)(Fts5Context*,
        -:235177:      int iPhrase, int iToken,
        -:235178:      const char **ppToken, int *pnToken
        -:235179:  );
        -:235180:  int (*xInstToken)(Fts5Context*, int iIdx, int iToken, const char**, int*);
        -:235181:
        -:235182:  /* Below this point are iVersion>=4 only */
        -:235183:  int (*xColumnLocale)(Fts5Context*, int iCol, const char **pz, int *pn);
        -:235184:  int (*xTokenize_v2)(Fts5Context*,
        -:235185:    const char *pText, int nText,      /* Text to tokenize */
        -:235186:    const char *pLocale, int nLocale,  /* Locale to pass to tokenizer */
        -:235187:    void *pCtx,                        /* Context passed to xToken() */
        -:235188:    int (*xToken)(void*, int, const char*, int, int, int)       /* Callback */
        -:235189:  );
        -:235190:};
        -:235191:
        -:235192:/*
        -:235193:** CUSTOM AUXILIARY FUNCTIONS
        -:235194:*************************************************************************/
        -:235195:
        -:235196:/*************************************************************************
        -:235197:** CUSTOM TOKENIZERS
        -:235198:**
        -:235199:** Applications may also register custom tokenizer types. A tokenizer
        -:235200:** is registered by providing fts5 with a populated instance of the
        -:235201:** following structure. All structure methods must be defined, setting
        -:235202:** any member of the fts5_tokenizer struct to NULL leads to undefined
        -:235203:** behaviour. The structure methods are expected to function as follows:
        -:235204:**
        -:235205:** xCreate:
        -:235206:**   This function is used to allocate and initialize a tokenizer instance.
        -:235207:**   A tokenizer instance is required to actually tokenize text.
        -:235208:**
        -:235209:**   The first argument passed to this function is a copy of the (void*)
        -:235210:**   pointer provided by the application when the fts5_tokenizer_v2 object
        -:235211:**   was registered with FTS5 (the third argument to xCreateTokenizer()).
        -:235212:**   The second and third arguments are an array of nul-terminated strings
        -:235213:**   containing the tokenizer arguments, if any, specified following the
        -:235214:**   tokenizer name as part of the CREATE VIRTUAL TABLE statement used
        -:235215:**   to create the FTS5 table.
        -:235216:**
        -:235217:**   The final argument is an output variable. If successful, (*ppOut)
        -:235218:**   should be set to point to the new tokenizer handle and SQLITE_OK
        -:235219:**   returned. If an error occurs, some value other than SQLITE_OK should
        -:235220:**   be returned. In this case, fts5 assumes that the final value of *ppOut
        -:235221:**   is undefined.
        -:235222:**
        -:235223:** xDelete:
        -:235224:**   This function is invoked to delete a tokenizer handle previously
        -:235225:**   allocated using xCreate(). Fts5 guarantees that this function will
        -:235226:**   be invoked exactly once for each successful call to xCreate().
        -:235227:**
        -:235228:** xTokenize:
        -:235229:**   This function is expected to tokenize the nText byte string indicated
        -:235230:**   by argument pText. pText may or may not be nul-terminated. The first
        -:235231:**   argument passed to this function is a pointer to an Fts5Tokenizer object
        -:235232:**   returned by an earlier call to xCreate().
        -:235233:**
        -:235234:**   The third argument indicates the reason that FTS5 is requesting
        -:235235:**   tokenization of the supplied text. This is always one of the following
        -:235236:**   four values:
        -:235237:**
        -:235238:**   <ul><li> <b>FTS5_TOKENIZE_DOCUMENT</b> - A document is being inserted into
        -:235239:**            or removed from the FTS table. The tokenizer is being invoked to
        -:235240:**            determine the set of tokens to add to (or delete from) the
        -:235241:**            FTS index.
        -:235242:**
        -:235243:**       <li> <b>FTS5_TOKENIZE_QUERY</b> - A MATCH query is being executed
        -:235244:**            against the FTS index. The tokenizer is being called to tokenize
        -:235245:**            a bareword or quoted string specified as part of the query.
        -:235246:**
        -:235247:**       <li> <b>(FTS5_TOKENIZE_QUERY | FTS5_TOKENIZE_PREFIX)</b> - Same as
        -:235248:**            FTS5_TOKENIZE_QUERY, except that the bareword or quoted string is
        -:235249:**            followed by a "*" character, indicating that the last token
        -:235250:**            returned by the tokenizer will be treated as a token prefix.
        -:235251:**
        -:235252:**       <li> <b>FTS5_TOKENIZE_AUX</b> - The tokenizer is being invoked to
        -:235253:**            satisfy an fts5_api.xTokenize() request made by an auxiliary
        -:235254:**            function. Or an fts5_api.xColumnSize() request made by the same
        -:235255:**            on a columnsize=0 database.
        -:235256:**   </ul>
        -:235257:**
        -:235258:**   The sixth and seventh arguments passed to xTokenize() - pLocale and
        -:235259:**   nLocale - are a pointer to a buffer containing the locale to use for
        -:235260:**   tokenization (e.g. "en_US") and its size in bytes, respectively. The
        -:235261:**   pLocale buffer is not nul-terminated. pLocale may be passed NULL (in
        -:235262:**   which case nLocale is always 0) to indicate that the tokenizer should
        -:235263:**   use its default locale.
        -:235264:**
        -:235265:**   For each token in the input string, the supplied callback xToken() must
        -:235266:**   be invoked. The first argument to it should be a copy of the pointer
        -:235267:**   passed as the second argument to xTokenize(). The third and fourth
        -:235268:**   arguments are a pointer to a buffer containing the token text, and the
        -:235269:**   size of the token in bytes. The 4th and 5th arguments are the byte offsets
        -:235270:**   of the first byte of and first byte immediately following the text from
        -:235271:**   which the token is derived within the input.
        -:235272:**
        -:235273:**   The second argument passed to the xToken() callback ("tflags") should
        -:235274:**   normally be set to 0. The exception is if the tokenizer supports
        -:235275:**   synonyms. In this case see the discussion below for details.
        -:235276:**
        -:235277:**   FTS5 assumes the xToken() callback is invoked for each token in the
        -:235278:**   order that they occur within the input text.
        -:235279:**
        -:235280:**   If an xToken() callback returns any value other than SQLITE_OK, then
        -:235281:**   the tokenization should be abandoned and the xTokenize() method should
        -:235282:**   immediately return a copy of the xToken() return value. Or, if the
        -:235283:**   input buffer is exhausted, xTokenize() should return SQLITE_OK. Finally,
        -:235284:**   if an error occurs with the xTokenize() implementation itself, it
        -:235285:**   may abandon the tokenization and return any error code other than
        -:235286:**   SQLITE_OK or SQLITE_DONE.
        -:235287:**
        -:235288:**   If the tokenizer is registered using an fts5_tokenizer_v2 object,
        -:235289:**   then the xTokenize() method has two additional arguments - pLocale
        -:235290:**   and nLocale. These specify the locale that the tokenizer should use
        -:235291:**   for the current request. If pLocale and nLocale are both 0, then the
        -:235292:**   tokenizer should use its default locale. Otherwise, pLocale points to
        -:235293:**   an nLocale byte buffer containing the name of the locale to use as utf-8
        -:235294:**   text. pLocale is not nul-terminated.
        -:235295:**
        -:235296:** FTS5_TOKENIZER
        -:235297:**
        -:235298:** There is also an fts5_tokenizer object. This is an older, deprecated,
        -:235299:** version of fts5_tokenizer_v2. It is similar except that:
        -:235300:**
        -:235301:**  <ul>
        -:235302:**    <li> There is no "iVersion" field, and
        -:235303:**    <li> The xTokenize() method does not take a locale argument.
        -:235304:**  </ul>
        -:235305:**
        -:235306:** Legacy fts5_tokenizer tokenizers must be registered using the
        -:235307:** legacy xCreateTokenizer() function, instead of xCreateTokenizer_v2().
        -:235308:**
        -:235309:** Tokenizer implementations registered using either API may be retrieved
        -:235310:** using both xFindTokenizer() and xFindTokenizer_v2().
        -:235311:**
        -:235312:** SYNONYM SUPPORT
        -:235313:**
        -:235314:**   Custom tokenizers may also support synonyms. Consider a case in which a
        -:235315:**   user wishes to query for a phrase such as "first place". Using the
        -:235316:**   built-in tokenizers, the FTS5 query 'first + place' will match instances
        -:235317:**   of "first place" within the document set, but not alternative forms
        -:235318:**   such as "1st place". In some applications, it would be better to match
        -:235319:**   all instances of "first place" or "1st place" regardless of which form
        -:235320:**   the user specified in the MATCH query text.
        -:235321:**
        -:235322:**   There are several ways to approach this in FTS5:
        -:235323:**
        -:235324:**   <ol><li> By mapping all synonyms to a single token. In this case, using
        -:235325:**            the above example, this means that the tokenizer returns the
        -:235326:**            same token for inputs "first" and "1st". Say that token is in
        -:235327:**            fact "first", so that when the user inserts the document "I won
        -:235328:**            1st place" entries are added to the index for tokens "i", "won",
        -:235329:**            "first" and "place". If the user then queries for '1st + place',
        -:235330:**            the tokenizer substitutes "first" for "1st" and the query works
        -:235331:**            as expected.
        -:235332:**
        -:235333:**       <li> By querying the index for all synonyms of each query term
        -:235334:**            separately. In this case, when tokenizing query text, the
        -:235335:**            tokenizer may provide multiple synonyms for a single term
        -:235336:**            within the document. FTS5 then queries the index for each
        -:235337:**            synonym individually. For example, faced with the query:
        -:235338:**
        -:235339:**   <codeblock>
        -:235340:**     ... MATCH 'first place'</codeblock>
        -:235341:**
        -:235342:**            the tokenizer offers both "1st" and "first" as synonyms for the
        -:235343:**            first token in the MATCH query and FTS5 effectively runs a query
        -:235344:**            similar to:
        -:235345:**
        -:235346:**   <codeblock>
        -:235347:**     ... MATCH '(first OR 1st) place'</codeblock>
        -:235348:**
        -:235349:**            except that, for the purposes of auxiliary functions, the query
        -:235350:**            still appears to contain just two phrases - "(first OR 1st)"
        -:235351:**            being treated as a single phrase.
        -:235352:**
        -:235353:**       <li> By adding multiple synonyms for a single term to the FTS index.
        -:235354:**            Using this method, when tokenizing document text, the tokenizer
        -:235355:**            provides multiple synonyms for each token. So that when a
        -:235356:**            document such as "I won first place" is tokenized, entries are
        -:235357:**            added to the FTS index for "i", "won", "first", "1st" and
        -:235358:**            "place".
        -:235359:**
        -:235360:**            This way, even if the tokenizer does not provide synonyms
        -:235361:**            when tokenizing query text (it should not - to do so would be
        -:235362:**            inefficient), it doesn't matter if the user queries for
        -:235363:**            'first + place' or '1st + place', as there are entries in the
        -:235364:**            FTS index corresponding to both forms of the first token.
        -:235365:**   </ol>
        -:235366:**
        -:235367:**   Whether it is parsing document or query text, any call to xToken that
        -:235368:**   specifies a <i>tflags</i> argument with the FTS5_TOKEN_COLOCATED bit
        -:235369:**   is considered to supply a synonym for the previous token. For example,
        -:235370:**   when parsing the document "I won first place", a tokenizer that supports
        -:235371:**   synonyms would call xToken() 5 times, as follows:
        -:235372:**
        -:235373:**   <codeblock>
        -:235374:**       xToken(pCtx, 0, "i",                      1,  0,  1);
        -:235375:**       xToken(pCtx, 0, "won",                    3,  2,  5);
        -:235376:**       xToken(pCtx, 0, "first",                  5,  6, 11);
        -:235377:**       xToken(pCtx, FTS5_TOKEN_COLOCATED, "1st", 3,  6, 11);
        -:235378:**       xToken(pCtx, 0, "place",                  5, 12, 17);
        -:235379:**</codeblock>
        -:235380:**
        -:235381:**   It is an error to specify the FTS5_TOKEN_COLOCATED flag the first time
        -:235382:**   xToken() is called. Multiple synonyms may be specified for a single token
        -:235383:**   by making multiple calls to xToken(FTS5_TOKEN_COLOCATED) in sequence.
        -:235384:**   There is no limit to the number of synonyms that may be provided for a
        -:235385:**   single token.
        -:235386:**
        -:235387:**   In many cases, method (1) above is the best approach. It does not add
        -:235388:**   extra data to the FTS index or require FTS5 to query for multiple terms,
        -:235389:**   so it is efficient in terms of disk space and query speed. However, it
        -:235390:**   does not support prefix queries very well. If, as suggested above, the
        -:235391:**   token "first" is substituted for "1st" by the tokenizer, then the query:
        -:235392:**
        -:235393:**   <codeblock>
        -:235394:**     ... MATCH '1s*'</codeblock>
        -:235395:**
        -:235396:**   will not match documents that contain the token "1st" (as the tokenizer
        -:235397:**   will probably not map "1s" to any prefix of "first").
        -:235398:**
        -:235399:**   For full prefix support, method (3) may be preferred. In this case,
        -:235400:**   because the index contains entries for both "first" and "1st", prefix
        -:235401:**   queries such as 'fi*' or '1s*' will match correctly. However, because
        -:235402:**   extra entries are added to the FTS index, this method uses more space
        -:235403:**   within the database.
        -:235404:**
        -:235405:**   Method (2) offers a midpoint between (1) and (3). Using this method,
        -:235406:**   a query such as '1s*' will match documents that contain the literal
        -:235407:**   token "1st", but not "first" (assuming the tokenizer is not able to
        -:235408:**   provide synonyms for prefixes). However, a non-prefix query like '1st'
        -:235409:**   will match against "1st" and "first". This method does not require
        -:235410:**   extra disk space, as no extra entries are added to the FTS index.
        -:235411:**   On the other hand, it may require more CPU cycles to run MATCH queries,
        -:235412:**   as separate queries of the FTS index are required for each synonym.
        -:235413:**
        -:235414:**   When using methods (2) or (3), it is important that the tokenizer only
        -:235415:**   provide synonyms when tokenizing document text (method (3)) or query
        -:235416:**   text (method (2)), not both. Doing so will not cause any errors, but is
        -:235417:**   inefficient.
        -:235418:*/
        -:235419:typedef struct Fts5Tokenizer Fts5Tokenizer;
        -:235420:typedef struct fts5_tokenizer_v2 fts5_tokenizer_v2;
        -:235421:struct fts5_tokenizer_v2 {
        -:235422:  int iVersion;             /* Currently always 2 */
        -:235423:
        -:235424:  int (*xCreate)(void*, const char **azArg, int nArg, Fts5Tokenizer **ppOut);
        -:235425:  void (*xDelete)(Fts5Tokenizer*);
        -:235426:  int (*xTokenize)(Fts5Tokenizer*,
        -:235427:      void *pCtx,
        -:235428:      int flags,            /* Mask of FTS5_TOKENIZE_* flags */
        -:235429:      const char *pText, int nText,
        -:235430:      const char *pLocale, int nLocale,
        -:235431:      int (*xToken)(
        -:235432:        void *pCtx,         /* Copy of 2nd argument to xTokenize() */
        -:235433:        int tflags,         /* Mask of FTS5_TOKEN_* flags */
        -:235434:        const char *pToken, /* Pointer to buffer containing token */
        -:235435:        int nToken,         /* Size of token in bytes */
        -:235436:        int iStart,         /* Byte offset of token within input text */
        -:235437:        int iEnd            /* Byte offset of end of token within input text */
        -:235438:      )
        -:235439:  );
        -:235440:};
        -:235441:
        -:235442:/*
        -:235443:** New code should use the fts5_tokenizer_v2 type to define tokenizer
        -:235444:** implementations. The following type is included for legacy applications
        -:235445:** that still use it.
        -:235446:*/
        -:235447:typedef struct fts5_tokenizer fts5_tokenizer;
        -:235448:struct fts5_tokenizer {
        -:235449:  int (*xCreate)(void*, const char **azArg, int nArg, Fts5Tokenizer **ppOut);
        -:235450:  void (*xDelete)(Fts5Tokenizer*);
        -:235451:  int (*xTokenize)(Fts5Tokenizer*,
        -:235452:      void *pCtx,
        -:235453:      int flags,            /* Mask of FTS5_TOKENIZE_* flags */
        -:235454:      const char *pText, int nText,
        -:235455:      int (*xToken)(
        -:235456:        void *pCtx,         /* Copy of 2nd argument to xTokenize() */
        -:235457:        int tflags,         /* Mask of FTS5_TOKEN_* flags */
        -:235458:        const char *pToken, /* Pointer to buffer containing token */
        -:235459:        int nToken,         /* Size of token in bytes */
        -:235460:        int iStart,         /* Byte offset of token within input text */
        -:235461:        int iEnd            /* Byte offset of end of token within input text */
        -:235462:      )
        -:235463:  );
        -:235464:};
        -:235465:
        -:235466:
        -:235467:/* Flags that may be passed as the third argument to xTokenize() */
        -:235468:#define FTS5_TOKENIZE_QUERY     0x0001
        -:235469:#define FTS5_TOKENIZE_PREFIX    0x0002
