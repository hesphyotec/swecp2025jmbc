        -: 1555:#define SQLITE_FCNTL_OVERWRITE              11
        -: 1556:#define SQLITE_FCNTL_VFSNAME                12
        -: 1557:#define SQLITE_FCNTL_POWERSAFE_OVERWRITE    13
