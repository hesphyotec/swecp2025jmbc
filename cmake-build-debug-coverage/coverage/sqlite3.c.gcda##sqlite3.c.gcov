        -:235476:
        -:235477:/*
        -:235478:** END OF CUSTOM TOKENIZERS
        -:235479:*************************************************************************/
        -:235480:
        -:235481:/*************************************************************************
        -:235482:** FTS5 EXTENSION REGISTRATION API
        -:235483:*/
        -:235484:typedef struct fts5_api fts5_api;
        -:235485:struct fts5_api {
        -:235486:  int iVersion;                   /* Currently always set to 3 */
        -:235487:
        -:235488:  /* Create a new tokenizer */
        -:235489:  int (*xCreateTokenizer)(
        -:235490:    fts5_api *pApi,
        -:235491:    const char *zName,
        -:235492:    void *pUserData,
