        -:188412:**    May you find forgiveness for yourself and forgive others.
        -:188413:**    May you share freely, never taking more than you give.
        -:188414:**
        -:188415:******************************************************************************
        -:188416:**
        -:188417:*/
        -:188418:#ifndef _FTSINT_H
        -:188419:#define _FTSINT_H
        -:188420:
        -:188421:/* #include <assert.h> */
        -:188422:/* #include <stdlib.h> */
        -:188423:/* #include <stddef.h> */
        -:188424:/* #include <stdio.h> */
        -:188425:/* #include <string.h> */
        -:188426:/* #include <stdarg.h> */
        -:188427:
        -:188428:#if !defined(NDEBUG) && !defined(SQLITE_DEBUG)
        -:188429:# define NDEBUG 1
        -:188430:#endif
        -:188431:
        -:188432:/* FTS3/FTS4 require virtual tables */
        -:188433:#ifdef SQLITE_OMIT_VIRTUALTABLE
        -:188434:# undef SQLITE_ENABLE_FTS3
        -:188435:# undef SQLITE_ENABLE_FTS4
        -:188436:#endif
        -:188437:
        -:188438:/*
        -:188439:** FTS4 is really an extension for FTS3.  It is enabled using the
        -:188440:** SQLITE_ENABLE_FTS3 macro.  But to avoid confusion we also all
        -:188441:** the SQLITE_ENABLE_FTS4 macro to serve as an alisse for SQLITE_ENABLE_FTS3.
        -:188442:*/
        -:188443:#if defined(SQLITE_ENABLE_FTS4) && !defined(SQLITE_ENABLE_FTS3)
        -:188444:# define SQLITE_ENABLE_FTS3
        -:188445:#endif
        -:188446:
        -:188447:#if !defined(SQLITE_CORE) || defined(SQLITE_ENABLE_FTS3)
        -:188448:
        -:188449:/* If not building as part of the core, include sqlite3ext.h. */
        -:188450:#ifndef SQLITE_CORE
        -:188451:/* # include "sqlite3ext.h" */
        -:188452:SQLITE_EXTENSION_INIT3
        -:188453:#endif
        -:188454:
        -:188455:/* #include "sqlite3.h" */
        -:188456:/************** Include fts3_tokenizer.h in the middle of fts3Int.h **********/
        -:188457:/************** Begin file fts3_tokenizer.h **********************************/
        -:188458:/*
        -:188459:** 2006 July 10
        -:188460:**
        -:188461:** The author disclaims copyright to this source code.
        -:188462:**
        -:188463:*************************************************************************
        -:188464:** Defines the interface to tokenizers used by fulltext-search.  There
        -:188465:** are three basic components:
        -:188466:**
        -:188467:** sqlite3_tokenizer_module is a singleton defining the tokenizer
        -:188468:** interface functions.  This is essentially the class structure for
        -:188469:** tokenizers.
        -:188470:**
        -:188471:** sqlite3_tokenizer is used to define a particular tokenizer, perhaps
        -:188472:** including customization information defined at creation time.
        -:188473:**
        -:188474:** sqlite3_tokenizer_cursor is generated by a tokenizer to generate
        -:188475:** tokens from a particular input.
        -:188476:*/
        -:188477:#ifndef _FTS3_TOKENIZER_H_
        -:188478:#define _FTS3_TOKENIZER_H_
        -:188479:
        -:188480:/* TODO(shess) Only used for SQLITE_OK and SQLITE_DONE at this time.
        -:188481:** If tokenizers are to be allowed to call sqlite3_*() functions, then
        -:188482:** we will need a way to register the API consistently.
        -:188483:*/
        -:188484:/* #include "sqlite3.h" */
        -:188485:
        -:188486:/*
        -:188487:** Structures used by the tokenizer interface. When a new tokenizer
        -:188488:** implementation is registered, the caller provides a pointer to
        -:188489:** an sqlite3_tokenizer_module containing pointers to the callback
        -:188490:** functions that make up an implementation.
        -:188491:**
        -:188492:** When an fts3 table is created, it passes any arguments passed to
        -:188493:** the tokenizer clause of the CREATE VIRTUAL TABLE statement to the
        -:188494:** sqlite3_tokenizer_module.xCreate() function of the requested tokenizer
        -:188495:** implementation. The xCreate() function in turn returns an
        -:188496:** sqlite3_tokenizer structure representing the specific tokenizer to
        -:188497:** be used for the fts3 table (customized by the tokenizer clause arguments).
        -:188498:**
        -:188499:** To tokenize an input buffer, the sqlite3_tokenizer_module.xOpen()
        -:188500:** method is called. It returns an sqlite3_tokenizer_cursor object
        -:188501:** that may be used to tokenize a specific input buffer based on
        -:188502:** the tokenization rules supplied by a specific sqlite3_tokenizer
        -:188503:** object.
        -:188504:*/
        -:188505:typedef struct sqlite3_tokenizer_module sqlite3_tokenizer_module;
        -:188506:typedef struct sqlite3_tokenizer sqlite3_tokenizer;
        -:188507:typedef struct sqlite3_tokenizer_cursor sqlite3_tokenizer_cursor;
        -:188508:
        -:188509:struct sqlite3_tokenizer_module {
        -:188510:
        -:188511:  /*
        -:188512:  ** Structure version. Should always be set to 0 or 1.
        -:188513:  */
        -:188514:  int iVersion;
        -:188515:
        -:188516:  /*
        -:188517:  ** Create a new tokenizer. The values in the argv[] array are the
        -:188518:  ** arguments passed to the "tokenizer" clause of the CREATE VIRTUAL
        -:188519:  ** TABLE statement that created the fts3 table. For example, if
        -:188520:  ** the following SQL is executed:
        -:188521:  **
        -:188522:  **   CREATE .. USING fts3( ... , tokenizer <tokenizer-name> arg1 arg2)
        -:188523:  **
        -:188524:  ** then argc is set to 2, and the argv[] array contains pointers
        -:188525:  ** to the strings "arg1" and "arg2".
        -:188526:  **
        -:188527:  ** This method should return either SQLITE_OK (0), or an SQLite error
        -:188528:  ** code. If SQLITE_OK is returned, then *ppTokenizer should be set
        -:188529:  ** to point at the newly created tokenizer structure. The generic
        -:188530:  ** sqlite3_tokenizer.pModule variable should not be initialized by
        -:188531:  ** this callback. The caller will do so.
        -:188532:  */
        -:188533:  int (*xCreate)(
        -:188534:    int argc,                           /* Size of argv array */
        -:188535:    const char *const*argv,             /* Tokenizer argument strings */
        -:188536:    sqlite3_tokenizer **ppTokenizer     /* OUT: Created tokenizer */
        -:188537:  );
        -:188538:
        -:188539:  /*
        -:188540:  ** Destroy an existing tokenizer. The fts3 module calls this method
        -:188541:  ** exactly once for each successful call to xCreate().
        -:188542:  */
        -:188543:  int (*xDestroy)(sqlite3_tokenizer *pTokenizer);
        -:188544:
        -:188545:  /*
        -:188546:  ** Create a tokenizer cursor to tokenize an input buffer. The caller
        -:188547:  ** is responsible for ensuring that the input buffer remains valid
        -:188548:  ** until the cursor is closed (using the xClose() method).
        -:188549:  */
        -:188550:  int (*xOpen)(
        -:188551:    sqlite3_tokenizer *pTokenizer,       /* Tokenizer object */
        -:188552:    const char *pInput, int nBytes,      /* Input buffer */
        -:188553:    sqlite3_tokenizer_cursor **ppCursor  /* OUT: Created tokenizer cursor */
        -:188554:  );
        -:188555:
        -:188556:  /*
        -:188557:  ** Destroy an existing tokenizer cursor. The fts3 module calls this
        -:188558:  ** method exactly once for each successful call to xOpen().
        -:188559:  */
        -:188560:  int (*xClose)(sqlite3_tokenizer_cursor *pCursor);
        -:188561:
        -:188562:  /*
        -:188563:  ** Retrieve the next token from the tokenizer cursor pCursor. This
        -:188564:  ** method should either return SQLITE_OK and set the values of the
        -:188565:  ** "OUT" variables identified below, or SQLITE_DONE to indicate that
        -:188566:  ** the end of the buffer has been reached, or an SQLite error code.
        -:188567:  **
        -:188568:  ** *ppToken should be set to point at a buffer containing the
        -:188569:  ** normalized version of the token (i.e. after any case-folding and/or
        -:188570:  ** stemming has been performed). *pnBytes should be set to the length
        -:188571:  ** of this buffer in bytes. The input text that generated the token is
        -:188572:  ** identified by the byte offsets returned in *piStartOffset and
        -:188573:  ** *piEndOffset. *piStartOffset should be set to the index of the first
        -:188574:  ** byte of the token in the input buffer. *piEndOffset should be set
        -:188575:  ** to the index of the first byte just past the end of the token in
        -:188576:  ** the input buffer.
        -:188577:  **
        -:188578:  ** The buffer *ppToken is set to point at is managed by the tokenizer
        -:188579:  ** implementation. It is only required to be valid until the next call
        -:188580:  ** to xNext() or xClose().
        -:188581:  */
        -:188582:  /* TODO(shess) current implementation requires pInput to be
        -:188583:  ** nul-terminated.  This should either be fixed, or pInput/nBytes
        -:188584:  ** should be converted to zInput.
        -:188585:  */
        -:188586:  int (*xNext)(
