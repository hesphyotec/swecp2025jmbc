        -:58684:  u8 extraSync;               /* sync directory after journal delete */
        -:58685:  u8 syncFlags;               /* SYNC_NORMAL or SYNC_FULL otherwise */
        -:58686:  u8 walSyncFlags;            /* See description above */
        -:58687:  u8 tempFile;                /* zFilename is a temporary or immutable file */
        -:58688:  u8 noLock;                  /* Do not lock (except in WAL mode) */
        -:58689:  u8 readOnly;                /* True for a read-only database */
