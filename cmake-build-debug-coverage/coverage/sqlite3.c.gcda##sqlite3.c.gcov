        -:57971:/* Connection to a write-ahead log (WAL) file.
        -:57972:** There is one object of this type for each pager.
        -:57973:*/
        -:57974:typedef struct Wal Wal;
        -:57975:
        -:57976:/* Open and close a connection to a write-ahead log. */
        -:57977:SQLITE_PRIVATE int sqlite3WalOpen(sqlite3_vfs*, sqlite3_file*, const char *, int, i64, Wal**);
        -:57978:SQLITE_PRIVATE int sqlite3WalClose(Wal *pWal, sqlite3*, int sync_flags, int, u8 *);
        -:57979:
        -:57980:/* Set the limiting size of a WAL file. */
        -:57981:SQLITE_PRIVATE void sqlite3WalLimit(Wal*, i64);
        -:57982:
        -:57983:/* Used by readers to open (lock) and close (unlock) a snapshot.  A
        -:57984:** snapshot is like a read-transaction.  It is the state of the database
        -:57985:** at an instant in time.  sqlite3WalOpenSnapshot gets a read lock and
        -:57986:** preserves the current state even if the other threads or processes
        -:57987:** write to or checkpoint the WAL.  sqlite3WalCloseSnapshot() closes the
        -:57988:** transaction and releases the lock.
        -:57989:*/
        -:57990:SQLITE_PRIVATE int sqlite3WalBeginReadTransaction(Wal *pWal, int *);
        -:57991:SQLITE_PRIVATE void sqlite3WalEndReadTransaction(Wal *pWal);
        -:57992:
        -:57993:/* Read a page from the write-ahead log, if it is present. */
        -:57994:SQLITE_PRIVATE int sqlite3WalFindFrame(Wal *, Pgno, u32 *);
        -:57995:SQLITE_PRIVATE int sqlite3WalReadFrame(Wal *, u32, int, u8 *);
        -:57996:
        -:57997:/* If the WAL is not empty, return the size of the database. */
        -:57998:SQLITE_PRIVATE Pgno sqlite3WalDbsize(Wal *pWal);
        -:57999:
        -:58000:/* Obtain or release the WRITER lock. */
        -:58001:SQLITE_PRIVATE int sqlite3WalBeginWriteTransaction(Wal *pWal);
        -:58002:SQLITE_PRIVATE int sqlite3WalEndWriteTransaction(Wal *pWal);
        -:58003:
        -:58004:/* Undo any frames written (but not committed) to the log */
        -:58005:SQLITE_PRIVATE int sqlite3WalUndo(Wal *pWal, int (*xUndo)(void *, Pgno), void *pUndoCtx);
        -:58006:
        -:58007:/* Return an integer that records the current (uncommitted) write
        -:58008:** position in the WAL */
        -:58009:SQLITE_PRIVATE void sqlite3WalSavepoint(Wal *pWal, u32 *aWalData);
        -:58010:
        -:58011:/* Move the write position of the WAL back to iFrame.  Called in
        -:58012:** response to a ROLLBACK TO command. */
        -:58013:SQLITE_PRIVATE int sqlite3WalSavepointUndo(Wal *pWal, u32 *aWalData);
        -:58014:
        -:58015:/* Write a frame or frames to the log. */
        -:58016:SQLITE_PRIVATE int sqlite3WalFrames(Wal *pWal, int, PgHdr *, Pgno, int, int);
        -:58017:
        -:58018:/* Copy pages from the log to the database file */
        -:58019:SQLITE_PRIVATE int sqlite3WalCheckpoint(
        -:58020:  Wal *pWal,                      /* Write-ahead log connection */
        -:58021:  sqlite3 *db,                    /* Check this handle's interrupt flag */
        -:58022:  int eMode,                      /* One of PASSIVE, FULL and RESTART */
        -:58023:  int (*xBusy)(void*),            /* Function to call when busy */
        -:58024:  void *pBusyArg,                 /* Context argument for xBusyHandler */
        -:58025:  int sync_flags,                 /* Flags to sync db file with (or 0) */
        -:58026:  int nBuf,                       /* Size of buffer nBuf */
        -:58027:  u8 *zBuf,                       /* Temporary buffer to use */
        -:58028:  int *pnLog,                     /* OUT: Number of frames in WAL */
        -:58029:  int *pnCkpt                     /* OUT: Number of backfilled frames in WAL */
        -:58030:);
        -:58031:
        -:58032:/* Return the value to pass to a sqlite3_wal_hook callback, the
        -:58033:** number of frames in the WAL at the point of the last commit since
        -:58034:** sqlite3WalCallback() was called.  If no commits have occurred since
        -:58035:** the last call, then return 0.
        -:58036:*/
        -:58037:SQLITE_PRIVATE int sqlite3WalCallback(Wal *pWal);
        -:58038:
        -:58039:/* Tell the wal layer that an EXCLUSIVE lock has been obtained (or released)
        -:58040:** by the pager layer on the database file.
        -:58041:*/
        -:58042:SQLITE_PRIVATE int sqlite3WalExclusiveMode(Wal *pWal, int op);
        -:58043:
        -:58044:/* Return true if the argument is non-NULL and the WAL module is using
        -:58045:** heap-memory for the wal-index. Otherwise, if the argument is NULL or the
        -:58046:** WAL module is using shared-memory, return false.
        -:58047:*/
        -:58048:SQLITE_PRIVATE int sqlite3WalHeapMemory(Wal *pWal);
        -:58049:
        -:58050:#ifdef SQLITE_ENABLE_SNAPSHOT
        -:58051:SQLITE_PRIVATE int sqlite3WalSnapshotGet(Wal *pWal, sqlite3_snapshot **ppSnapshot);
        -:58052:SQLITE_PRIVATE void sqlite3WalSnapshotOpen(Wal *pWal, sqlite3_snapshot *pSnapshot);
        -:58053:SQLITE_PRIVATE int sqlite3WalSnapshotRecover(Wal *pWal);
        -:58054:SQLITE_PRIVATE int sqlite3WalSnapshotCheck(Wal *pWal, sqlite3_snapshot *pSnapshot);
        -:58055:SQLITE_PRIVATE void sqlite3WalSnapshotUnlock(Wal *pWal);
        -:58056:#endif
        -:58057:
        -:58058:#ifdef SQLITE_ENABLE_ZIPVFS
        -:58059:/* If the WAL file is not empty, return the number of bytes of content
        -:58060:** stored in each frame (i.e. the db page-size when the WAL was created).
        -:58061:*/
        -:58062:SQLITE_PRIVATE int sqlite3WalFramesize(Wal *pWal);
        -:58063:#endif
        -:58064:
        -:58065:/* Return the sqlite3_file object for the WAL file */
        -:58066:SQLITE_PRIVATE sqlite3_file *sqlite3WalFile(Wal *pWal);
        -:58067:
        -:58068:#ifdef SQLITE_ENABLE_SETLK_TIMEOUT
        -:58069:SQLITE_PRIVATE int sqlite3WalWriteLock(Wal *pWal, int bLock);
        -:58070:SQLITE_PRIVATE void sqlite3WalDb(Wal *pWal, sqlite3 *db);
        -:58071:#endif
        -:58072:
        -:58073:#ifdef SQLITE_USE_SEH
        -:58074:SQLITE_PRIVATE int sqlite3WalSystemErrno(Wal*);
        -:58075:#endif
        -:58076:
        -:58077:#endif /* ifndef SQLITE_OMIT_WAL */
        -:58078:#endif /* SQLITE_WAL_H */
