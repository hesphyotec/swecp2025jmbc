        -:196900:  int iLangid,                        /* Language id for tokenizer */
        -:196901:  char **azCol,                       /* Array of column names for fts3 table */
        -:196902:  int bFts4,                          /* True to allow FTS4-only syntax */
        -:196903:  int nCol,                           /* Number of entries in azCol[] */
        -:196904:  int iDefaultCol,                    /* Default column to query */
        -:196905:  const char *z, int n,               /* Text of MATCH query */
        -:196906:  Fts3Expr **ppExpr,                  /* OUT: Parsed query structure */
        -:196907:  char **pzErr                        /* OUT: Error message (sqlite3_malloc) */
        -:196908:){
