        -:20451:/*
        -:20452:** Each trigger present in the database schema is stored as an instance of
        -:20453:** struct Trigger.
        -:20454:**
        -:20455:** Pointers to instances of struct Trigger are stored in two ways.
        -:20456:** 1. In the "trigHash" hash table (part of the sqlite3* that represents the
        -:20457:**    database). This allows Trigger structures to be retrieved by name.
        -:20458:** 2. All triggers associated with a single table form a linked list, using the
        -:20459:**    pNext member of struct Trigger. A pointer to the first element of the
        -:20460:**    linked list is stored as the "pTrigger" member of the associated
        -:20461:**    struct Table.
        -:20462:**
        -:20463:** The "step_list" member points to the first element of a linked list
        -:20464:** containing the SQL statements specified as the trigger program.
        -:20465:*/
        -:20466:struct Trigger {
        -:20467:  char *zName;            /* The name of the trigger                        */
        -:20468:  char *table;            /* The table or view to which the trigger applies */
        -:20469:  u8 op;                  /* One of TK_DELETE, TK_UPDATE, TK_INSERT         */
        -:20470:  u8 tr_tm;               /* One of TRIGGER_BEFORE, TRIGGER_AFTER */
        -:20471:  u8 bReturning;          /* This trigger implements a RETURNING clause */
        -:20472:  Expr *pWhen;            /* The WHEN clause of the expression (may be NULL) */
        -:20473:  IdList *pColumns;       /* If this is an UPDATE OF <column-list> trigger,
        -:20474:                             the <column-list> is stored here */
        -:20475:  Schema *pSchema;        /* Schema containing the trigger */
        -:20476:  Schema *pTabSchema;     /* Schema containing the table */
        -:20477:  TriggerStep *step_list; /* Link list of trigger program steps             */
        -:20478:  Trigger *pNext;         /* Next trigger associated with the table */
        -:20479:};
        -:20480:
        -:20481:/*
        -:20482:** A trigger is either a BEFORE or an AFTER trigger.  The following constants
        -:20483:** determine which.
        -:20484:**
        -:20485:** If there are multiple triggers, you might of some BEFORE and some AFTER.
        -:20486:** In that cases, the constants below can be ORed together.
        -:20487:*/
        -:20488:#define TRIGGER_BEFORE  1
        -:20489:#define TRIGGER_AFTER   2
        -:20490:
        -:20491:/*
        -:20492:** An instance of struct TriggerStep is used to store a single SQL statement
        -:20493:** that is a part of a trigger-program.
        -:20494:**
        -:20495:** Instances of struct TriggerStep are stored in a singly linked list (linked
        -:20496:** using the "pNext" member) referenced by the "step_list" member of the
        -:20497:** associated struct Trigger instance. The first element of the linked list is
        -:20498:** the first step of the trigger-program.
        -:20499:**
        -:20500:** The "op" member indicates whether this is a "DELETE", "INSERT", "UPDATE" or
        -:20501:** "SELECT" statement. The meanings of the other members is determined by the
        -:20502:** value of "op" as follows:
        -:20503:**
        -:20504:** (op == TK_INSERT)
        -:20505:** orconf    -> stores the ON CONFLICT algorithm
        -:20506:** pSelect   -> The content to be inserted - either a SELECT statement or
        -:20507:**              a VALUES clause.
        -:20508:** zTarget   -> Dequoted name of the table to insert into.
        -:20509:** pIdList   -> If this is an INSERT INTO ... (<column-names>) VALUES ...
        -:20510:**              statement, then this stores the column-names to be
        -:20511:**              inserted into.
        -:20512:** pUpsert   -> The ON CONFLICT clauses for an Upsert
        -:20513:**
        -:20514:** (op == TK_DELETE)
        -:20515:** zTarget   -> Dequoted name of the table to delete from.
        -:20516:** pWhere    -> The WHERE clause of the DELETE statement if one is specified.
        -:20517:**              Otherwise NULL.
        -:20518:**
        -:20519:** (op == TK_UPDATE)
        -:20520:** zTarget   -> Dequoted name of the table to update.
        -:20521:** pWhere    -> The WHERE clause of the UPDATE statement if one is specified.
        -:20522:**              Otherwise NULL.
        -:20523:** pExprList -> A list of the columns to update and the expressions to update
        -:20524:**              them to. See sqlite3Update() documentation of "pChanges"
        -:20525:**              argument.
        -:20526:**
        -:20527:** (op == TK_SELECT)
        -:20528:** pSelect   -> The SELECT statement
        -:20529:**
        -:20530:** (op == TK_RETURNING)
        -:20531:** pExprList -> The list of expressions that follow the RETURNING keyword.
        -:20532:**
        -:20533:*/
        -:20534:struct TriggerStep {
        -:20535:  u8 op;               /* One of TK_DELETE, TK_UPDATE, TK_INSERT, TK_SELECT,
        -:20536:                       ** or TK_RETURNING */
        -:20537:  u8 orconf;           /* OE_Rollback etc. */
        -:20538:  Trigger *pTrig;      /* The trigger that this step is a part of */
        -:20539:  Select *pSelect;     /* SELECT statement or RHS of INSERT INTO SELECT ... */
        -:20540:  char *zTarget;       /* Target table for DELETE, UPDATE, INSERT */
        -:20541:  SrcList *pFrom;      /* FROM clause for UPDATE statement (if any) */
        -:20542:  Expr *pWhere;        /* The WHERE clause for DELETE or UPDATE steps */
        -:20543:  ExprList *pExprList; /* SET clause for UPDATE, or RETURNING clause */
        -:20544:  IdList *pIdList;     /* Column names for INSERT */
        -:20545:  Upsert *pUpsert;     /* Upsert clauses on an INSERT */
        -:20546:  char *zSpan;         /* Original SQL text of this command */
        -:20547:  TriggerStep *pNext;  /* Next in the link-list */
        -:20548:  TriggerStep *pLast;  /* Last element in link-list. Valid for 1st elem only */
        -:20549:};
        -:20550:
        -:20551:/*
