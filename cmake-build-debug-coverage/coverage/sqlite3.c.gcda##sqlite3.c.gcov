        -:71060:#define BTCURSOR_FIRST_UNINIT pBt   /* Name of first uninitialized field */
        -:71061:  BtShared *pBt;            /* The BtShared this cursor points to */
        -:71062:  BtCursor *pNext;          /* Forms a linked list of all cursors */
        -:71063:  CellInfo info;            /* A parse of the cell we are pointing at */
