        -:20131:  int iSDParm2;        /* A second parameter for the eDest disposal method */
        -:20132:  int iSdst;           /* Base register where results are written */
        -:20133:  int nSdst;           /* Number of registers allocated */
        -:20134:  char *zAffSdst;      /* Affinity used for SRT_Set */
        -:20135:  ExprList *pOrderBy;  /* Key columns for SRT_Queue and SRT_DistQueue */
        -:20136:};
        -:20137:
        -:20138:/*
        -:20139:** During code generation of statements that do inserts into AUTOINCREMENT
        -:20140:** tables, the following information is attached to the Table.u.autoInc.p
        -:20141:** pointer of each autoincrement table to record some side information that
        -:20142:** the code generator needs.  We have to keep per-table autoincrement
        -:20143:** information in case inserts are done within triggers.  Triggers do not
        -:20144:** normally coordinate their activities, but we do need to coordinate the
        -:20145:** loading and saving of autoincrement information.
        -:20146:*/
        -:20147:struct AutoincInfo {
        -:20148:  AutoincInfo *pNext;   /* Next info block in a list of them all */
        -:20149:  Table *pTab;          /* Table this info block refers to */
        -:20150:  int iDb;              /* Index in sqlite3.aDb[] of database holding pTab */
        -:20151:  int regCtr;           /* Memory register holding the rowid counter */
        -:20152:};
        -:20153:
        -:20154:/*
        -:20155:** At least one instance of the following structure is created for each
        -:20156:** trigger that may be fired while parsing an INSERT, UPDATE or DELETE
        -:20157:** statement. All such objects are stored in the linked list headed at
        -:20158:** Parse.pTriggerPrg and deleted once statement compilation has been
        -:20159:** completed.
        -:20160:**
        -:20161:** A Vdbe sub-program that implements the body and WHEN clause of trigger
        -:20162:** TriggerPrg.pTrigger, assuming a default ON CONFLICT clause of
        -:20163:** TriggerPrg.orconf, is stored in the TriggerPrg.pProgram variable.
        -:20164:** The Parse.pTriggerPrg list never contains two entries with the same
        -:20165:** values for both pTrigger and orconf.
        -:20166:**
        -:20167:** The TriggerPrg.aColmask[0] variable is set to a mask of old.* columns
        -:20168:** accessed (or set to 0 for triggers fired as a result of INSERT
        -:20169:** statements). Similarly, the TriggerPrg.aColmask[1] variable is set to
        -:20170:** a mask of new.* columns used by the program.
        -:20171:*/
        -:20172:struct TriggerPrg {
        -:20173:  Trigger *pTrigger;      /* Trigger this program was coded from */
        -:20174:  TriggerPrg *pNext;      /* Next entry in Parse.pTriggerPrg list */
        -:20175:  SubProgram *pProgram;   /* Program implementing pTrigger/orconf */
        -:20176:  int orconf;             /* Default ON CONFLICT policy */
        -:20177:  u32 aColmask[2];        /* Masks of old.*, new.* columns accessed */
        -:20178:};
        -:20179:
        -:20180:/*
        -:20181:** The yDbMask datatype for the bitmask of all attached databases.
        -:20182:*/
        -:20183:#if SQLITE_MAX_ATTACHED>30
        -:20184:  typedef unsigned char yDbMask[(SQLITE_MAX_ATTACHED+9)/8];
        -:20185:# define DbMaskTest(M,I)    (((M)[(I)/8]&(1<<((I)&7)))!=0)
        -:20186:# define DbMaskZero(M)      memset((M),0,sizeof(M))
        -:20187:# define DbMaskSet(M,I)     (M)[(I)/8]|=(1<<((I)&7))
        -:20188:# define DbMaskAllZero(M)   sqlite3DbMaskAllZero(M)
        -:20189:# define DbMaskNonZero(M)   (sqlite3DbMaskAllZero(M)==0)
        -:20190:#else
        -:20191:  typedef unsigned int yDbMask;
        -:20192:# define DbMaskTest(M,I)    (((M)&(((yDbMask)1)<<(I)))!=0)
        -:20193:# define DbMaskZero(M)      ((M)=0)
        -:20194:# define DbMaskSet(M,I)     ((M)|=(((yDbMask)1)<<(I)))
        -:20195:# define DbMaskAllZero(M)   ((M)==0)
        -:20196:# define DbMaskNonZero(M)   ((M)!=0)
        -:20197:#endif
        -:20198:
        -:20199:/*
        -:20200:** For each index X that has as one of its arguments either an expression
        -:20201:** or the name of a virtual generated column, and if X is in scope such that
        -:20202:** the value of the expression can simply be read from the index, then
        -:20203:** there is an instance of this object on the Parse.pIdxExpr list.
        -:20204:**
        -:20205:** During code generation, while generating code to evaluate expressions,
        -:20206:** this list is consulted and if a matching expression is found, the value
        -:20207:** is read from the index rather than being recomputed.
        -:20208:*/
        -:20209:struct IndexedExpr {
        -:20210:  Expr *pExpr;            /* The expression contained in the index */
        -:20211:  int iDataCur;           /* The data cursor associated with the index */
        -:20212:  int iIdxCur;            /* The index cursor */
        -:20213:  int iIdxCol;            /* The index column that contains value of pExpr */
        -:20214:  u8 bMaybeNullRow;       /* True if we need an OP_IfNullRow check */
