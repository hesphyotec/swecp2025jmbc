        -:23643:/* Types of VDBE cursors */
        -:23644:#define CURTYPE_BTREE       0
        -:23645:#define CURTYPE_SORTER      1
        -:23646:#define CURTYPE_VTAB        2
        -:23647:#define CURTYPE_PSEUDO      3
        -:23648:
        -:23649:/*
        -:23650:** A VdbeCursor is an superclass (a wrapper) for various cursor objects:
        -:23651:**
        -:23652:**      * A b-tree cursor
        -:23653:**          -  In the main database or in an ephemeral database
        -:23654:**          -  On either an index or a table
        -:23655:**      * A sorter
        -:23656:**      * A virtual table
        -:23657:**      * A one-row "pseudotable" stored in a single register
        -:23658:*/
        -:23659:typedef struct VdbeCursor VdbeCursor;
        -:23660:struct VdbeCursor {
        -:23661:  u8 eCurType;            /* One of the CURTYPE_* values above */
        -:23662:  i8 iDb;                 /* Index of cursor database in db->aDb[] */
        -:23663:  u8 nullRow;             /* True if pointing to a row with no data */
        -:23664:  u8 deferredMoveto;      /* A call to sqlite3BtreeMoveto() is needed */
        -:23665:  u8 isTable;             /* True for rowid tables.  False for indexes */
        -:23666:#ifdef SQLITE_DEBUG
        -:23667:  u8 seekOp;              /* Most recent seek operation on this cursor */
        -:23668:  u8 wrFlag;              /* The wrFlag argument to sqlite3BtreeCursor() */
        -:23669:#endif
        -:23670:  Bool isEphemeral:1;     /* True for an ephemeral table */
        -:23671:  Bool useRandomRowid:1;  /* Generate new record numbers semi-randomly */
        -:23672:  Bool isOrdered:1;       /* True if the table is not BTREE_UNORDERED */
        -:23673:  Bool noReuse:1;         /* OpenEphemeral may not reuse this cursor */
        -:23674:  Bool colCache:1;        /* pCache pointer is initialized and non-NULL */
        -:23675:  u16 seekHit;            /* See the OP_SeekHit and OP_IfNoHope opcodes */
        -:23676:  union {                 /* pBtx for isEphermeral.  pAltMap otherwise */
        -:23677:    Btree *pBtx;            /* Separate file holding temporary table */
        -:23678:    u32 *aAltMap;           /* Mapping from table to index column numbers */
        -:23679:  } ub;
        -:23680:  i64 seqCount;           /* Sequence counter */
        -:23681:
        -:23682:  /* Cached OP_Column parse information is only valid if cacheStatus matches
        -:23683:  ** Vdbe.cacheCtr.  Vdbe.cacheCtr will never take on the value of
        -:23684:  ** CACHE_STALE (0) and so setting cacheStatus=CACHE_STALE guarantees that
        -:23685:  ** the cache is out of date. */
        -:23686:  u32 cacheStatus;        /* Cache is valid if this matches Vdbe.cacheCtr */
        -:23687:  int seekResult;         /* Result of previous sqlite3BtreeMoveto() or 0
        -:23688:                          ** if there have been no prior seeks on the cursor. */
        -:23689:  /* seekResult does not distinguish between "no seeks have ever occurred
        -:23690:  ** on this cursor" and "the most recent seek was an exact match".
        -:23691:  ** For CURTYPE_PSEUDO, seekResult is the register holding the record */
        -:23692:
        -:23693:  /* When a new VdbeCursor is allocated, only the fields above are zeroed.
        -:23694:  ** The fields that follow are uninitialized, and must be individually
        -:23695:  ** initialized prior to first use. */
        -:23696:  VdbeCursor *pAltCursor; /* Associated index cursor from which to read */
        -:23697:  union {
        -:23698:    BtCursor *pCursor;          /* CURTYPE_BTREE or _PSEUDO.  Btree cursor */
        -:23699:    sqlite3_vtab_cursor *pVCur; /* CURTYPE_VTAB.              Vtab cursor */
        -:23700:    VdbeSorter *pSorter;        /* CURTYPE_SORTER.            Sorter object */
        -:23701:  } uc;
        -:23702:  KeyInfo *pKeyInfo;      /* Info about index keys needed by index cursors */
        -:23703:  u32 iHdrOffset;         /* Offset to next unparsed byte of the header */
        -:23704:  Pgno pgnoRoot;          /* Root page of the open btree cursor */
        -:23705:  i16 nField;             /* Number of fields in the header */
        -:23706:  u16 nHdrParsed;         /* Number of header fields parsed so far */
        -:23707:  i64 movetoTarget;       /* Argument to the deferred sqlite3BtreeMoveto() */
        -:23708:  u32 *aOffset;           /* Pointer to aType[nField] */
        -:23709:  const u8 *aRow;         /* Data for the current row, if all on one page */
        -:23710:  u32 payloadSize;        /* Total number of bytes in the record */
        -:23711:  u32 szRow;              /* Byte available in aRow */
        -:23712:#ifdef SQLITE_ENABLE_COLUMN_USED_MASK
        -:23713:  u64 maskUsed;           /* Mask of columns used by this cursor */
        -:23714:#endif
        -:23715:  VdbeTxtBlbCache *pCache; /* Cache of large TEXT or BLOB values */
        -:23716:
        -:23717:  /* Space is allocated for aType to hold at least 2*nField+1 entries:
        -:23718:  ** nField slots for aType[] and nField+1 array slots for aOffset[] */
        -:23719:  u32 aType[FLEXARRAY];    /* Type values record decode.  MUST BE LAST */
        -:23720:};
        -:23721:
        -:23722:/*
        -:23723:** The size (in bytes) of a VdbeCursor object that has an nField value of N
        -:23724:** or less.  The value of SZ_VDBECURSOR(n) is guaranteed to be a multiple
        -:23725:** of 8.
        -:23726:*/
        -:23727:#define SZ_VDBECURSOR(N) \
        -:23728:    (ROUND8(offsetof(VdbeCursor,aType)) + ((N)+1)*sizeof(u64))
        -:23729:
        -:23730:/* Return true if P is a null-only cursor
        -:23731:*/
        -:23732:#define IsNullCursor(P) \
        -:23733:  ((P)->eCurType==CURTYPE_PSEUDO && (P)->nullRow && (P)->seekResult==0)
        -:23734:
        -:23735:/*
        -:23736:** A value for VdbeCursor.cacheStatus that means the cache is always invalid.
        -:23737:*/
        -:23738:#define CACHE_STALE 0
        -:23739:
        -:23740:/*
        -:23741:** Large TEXT or BLOB values can be slow to load, so we want to avoid
        -:23742:** loading them more than once.  For that reason, large TEXT and BLOB values
        -:23743:** can be stored in a cache defined by this object, and attached to the
        -:23744:** VdbeCursor using the pCache field.
        -:23745:*/
        -:23746:struct VdbeTxtBlbCache {
        -:23747:  char *pCValue;        /* A RCStr buffer to hold the value */
        -:23748:  i64 iOffset;          /* File offset of the row being cached */
        -:23749:  int iCol;             /* Column for which the cache is valid */
        -:23750:  u32 cacheStatus;      /* Vdbe.cacheCtr value */
        -:23751:  u32 colCacheCtr;      /* Column cache counter */
        -:23752:};
        -:23753:
        -:23754:/*
        -:23755:** When a sub-program is executed (OP_Program), a structure of this type
        -:23756:** is allocated to store the current value of the program counter, as
        -:23757:** well as the current memory cell array and various other frame specific
        -:23758:** values stored in the Vdbe struct. When the sub-program is finished,
        -:23759:** these values are copied back to the Vdbe from the VdbeFrame structure,
        -:23760:** restoring the state of the VM to as it was before the sub-program
        -:23761:** began executing.
        -:23762:**
        -:23763:** The memory for a VdbeFrame object is allocated and managed by a memory
        -:23764:** cell in the parent (calling) frame. When the memory cell is deleted or
        -:23765:** overwritten, the VdbeFrame object is not freed immediately. Instead, it
        -:23766:** is linked into the Vdbe.pDelFrame list. The contents of the Vdbe.pDelFrame
        -:23767:** list is deleted when the VM is reset in VdbeHalt(). The reason for doing
        -:23768:** this instead of deleting the VdbeFrame immediately is to avoid recursive
        -:23769:** calls to sqlite3VdbeMemRelease() when the memory cells belonging to the
        -:23770:** child frame are released.
        -:23771:**
        -:23772:** The currently executing frame is stored in Vdbe.pFrame. Vdbe.pFrame is
        -:23773:** set to NULL if the currently executing frame is the main program.
        -:23774:*/
        -:23775:typedef struct VdbeFrame VdbeFrame;
        -:23776:struct VdbeFrame {
        -:23777:  Vdbe *v;                /* VM this frame belongs to */
        -:23778:  VdbeFrame *pParent;     /* Parent of this frame, or NULL if parent is main */
        -:23779:  Op *aOp;                /* Program instructions for parent frame */
        -:23780:  Mem *aMem;              /* Array of memory cells for parent frame */
        -:23781:  VdbeCursor **apCsr;     /* Array of Vdbe cursors for parent frame */
        -:23782:  u8 *aOnce;              /* Bitmask used by OP_Once */
        -:23783:  void *token;            /* Copy of SubProgram.token */
        -:23784:  i64 lastRowid;          /* Last insert rowid (sqlite3.lastRowid) */
        -:23785:  AuxData *pAuxData;      /* Linked list of auxdata allocations */
        -:23786:#if SQLITE_DEBUG
        -:23787:  u32 iFrameMagic;        /* magic number for sanity checking */
        -:23788:#endif
