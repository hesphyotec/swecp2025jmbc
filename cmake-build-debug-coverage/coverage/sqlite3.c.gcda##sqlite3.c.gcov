        -:71121:
        -:71122:/*
        -:71123:** The database page the PENDING_BYTE occupies. This page is never used.
        -:71124:*/
        -:71125:#define PENDING_BYTE_PAGE(pBt)  ((Pgno)((PENDING_BYTE/((pBt)->pageSize))+1))
        -:71126:
        -:71127:/*
        -:71128:** These macros define the location of the pointer-map entry for a
        -:71129:** database page. The first argument to each is the number of usable
        -:71130:** bytes on each page of the database (often 1024). The second is the
        -:71131:** page number to look up in the pointer map.
        -:71132:**
        -:71133:** PTRMAP_PAGENO returns the database page number of the pointer-map
        -:71134:** page that stores the required pointer. PTRMAP_PTROFFSET returns
        -:71135:** the offset of the requested map entry.
        -:71136:**
        -:71137:** If the pgno argument passed to PTRMAP_PAGENO is a pointer-map page,
        -:71138:** then pgno is returned. So (pgno==PTRMAP_PAGENO(pgsz, pgno)) can be
        -:71139:** used to test if pgno is a pointer-map page. PTRMAP_ISPAGE implements
        -:71140:** this test.
        -:71141:*/
        -:71142:#define PTRMAP_PAGENO(pBt, pgno) ptrmapPageno(pBt, pgno)
