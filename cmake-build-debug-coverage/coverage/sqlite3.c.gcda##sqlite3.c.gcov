        -:70507:**
        -:70508:*************************************************************************
        -:70509:**
        -:70510:** This file contains code used to implement mutexes on Btree objects.
        -:70511:** This code really belongs in btree.c.  But btree.c is getting too
        -:70512:** big and we want to break it down some.  This packaged seemed like
        -:70513:** a good breakout.
        -:70514:*/
        -:70515:/************** Include btreeInt.h in the middle of btmutex.c ****************/
        -:70516:/************** Begin file btreeInt.h ****************************************/
        -:70517:/*
        -:70518:** 2004 April 6
        -:70519:**
        -:70520:** The author disclaims copyright to this source code.  In place of
        -:70521:** a legal notice, here is a blessing:
        -:70522:**
        -:70523:**    May you do good and not evil.
        -:70524:**    May you find forgiveness for yourself and forgive others.
        -:70525:**    May you share freely, never taking more than you give.
        -:70526:**
        -:70527:*************************************************************************
        -:70528:** This file implements an external (disk-based) database using BTrees.
        -:70529:** For a detailed discussion of BTrees, refer to
        -:70530:**
        -:70531:**     Donald E. Knuth, THE ART OF COMPUTER PROGRAMMING, Volume 3:
        -:70532:**     "Sorting And Searching", pages 473-480. Addison-Wesley
        -:70533:**     Publishing Company, Reading, Massachusetts.
        -:70534:**
        -:70535:** The basic idea is that each page of the file contains N database
        -:70536:** entries and N+1 pointers to subpages.
        -:70537:**
        -:70538:**   ----------------------------------------------------------------
        -:70539:**   |  Ptr(0) | Key(0) | Ptr(1) | Key(1) | ... | Key(N-1) | Ptr(N) |
        -:70540:**   ----------------------------------------------------------------
        -:70541:**
        -:70542:** All of the keys on the page that Ptr(0) points to have values less
        -:70543:** than Key(0).  All of the keys on page Ptr(1) and its subpages have
        -:70544:** values greater than Key(0) and less than Key(1).  All of the keys
        -:70545:** on Ptr(N) and its subpages have values greater than Key(N-1).  And
        -:70546:** so forth.
        -:70547:**
        -:70548:** Finding a particular key requires reading O(log(M)) pages from the
        -:70549:** disk where M is the number of entries in the tree.
        -:70550:**
        -:70551:** In this implementation, a single file can hold one or more separate
        -:70552:** BTrees.  Each BTree is identified by the index of its root page.  The
        -:70553:** key and data for any entry are combined to form the "payload".  A
        -:70554:** fixed amount of payload can be carried directly on the database
        -:70555:** page.  If the payload is larger than the preset amount then surplus
        -:70556:** bytes are stored on overflow pages.  The payload for an entry
        -:70557:** and the preceding pointer are combined to form a "Cell".  Each
        -:70558:** page has a small header which contains the Ptr(N) pointer and other
        -:70559:** information such as the size of key and data.
        -:70560:**
        -:70561:** FORMAT DETAILS
        -:70562:**
        -:70563:** The file is divided into pages.  The first page is called page 1,
        -:70564:** the second is page 2, and so forth.  A page number of zero indicates
        -:70565:** "no such page".  The page size can be any power of 2 between 512 and 65536.
        -:70566:** Each page can be either a btree page, a freelist page, an overflow
        -:70567:** page, or a pointer-map page.
        -:70568:**
        -:70569:** The first page is always a btree page.  The first 100 bytes of the first
        -:70570:** page contain a special header (the "file header") that describes the file.
        -:70571:** The format of the file header is as follows:
        -:70572:**
        -:70573:**   OFFSET   SIZE    DESCRIPTION
        -:70574:**      0      16     Header string: "SQLite format 3\000"
        -:70575:**     16       2     Page size in bytes.  (1 means 65536)
        -:70576:**     18       1     File format write version
        -:70577:**     19       1     File format read version
        -:70578:**     20       1     Bytes of unused space at the end of each page
        -:70579:**     21       1     Max embedded payload fraction (must be 64)
        -:70580:**     22       1     Min embedded payload fraction (must be 32)
        -:70581:**     23       1     Min leaf payload fraction (must be 32)
        -:70582:**     24       4     File change counter
        -:70583:**     28       4     The size of the database in pages
        -:70584:**     32       4     First freelist page
        -:70585:**     36       4     Number of freelist pages in the file
        -:70586:**     40      60     15 4-byte meta values passed to higher layers
        -:70587:**
        -:70588:**     40       4     Schema cookie
        -:70589:**     44       4     File format of schema layer
        -:70590:**     48       4     Size of page cache
        -:70591:**     52       4     Largest root-page (auto/incr_vacuum)
        -:70592:**     56       4     1=UTF-8 2=UTF16le 3=UTF16be
        -:70593:**     60       4     User version
        -:70594:**     64       4     Incremental vacuum mode
        -:70595:**     68       4     Application-ID
        -:70596:**     72      20     unused
        -:70597:**     92       4     The version-valid-for number
        -:70598:**     96       4     SQLITE_VERSION_NUMBER
        -:70599:**
        -:70600:** All of the integer values are big-endian (most significant byte first).
        -:70601:**
        -:70602:** The file change counter is incremented when the database is changed
        -:70603:** This counter allows other processes to know when the file has changed
        -:70604:** and thus when they need to flush their cache.
        -:70605:**
        -:70606:** The max embedded payload fraction is the amount of the total usable
        -:70607:** space in a page that can be consumed by a single cell for standard
        -:70608:** B-tree (non-LEAFDATA) tables.  A value of 255 means 100%.  The default
        -:70609:** is to limit the maximum cell size so that at least 4 cells will fit
        -:70610:** on one page.  Thus the default max embedded payload fraction is 64.
        -:70611:**
        -:70612:** If the payload for a cell is larger than the max payload, then extra
        -:70613:** payload is spilled to overflow pages.  Once an overflow page is allocated,
        -:70614:** as many bytes as possible are moved into the overflow pages without letting
        -:70615:** the cell size drop below the min embedded payload fraction.
        -:70616:**
        -:70617:** The min leaf payload fraction is like the min embedded payload fraction
        -:70618:** except that it applies to leaf nodes in a LEAFDATA tree.  The maximum
        -:70619:** payload fraction for a LEAFDATA tree is always 100% (or 255) and it
        -:70620:** not specified in the header.
        -:70621:**
        -:70622:** Each btree pages is divided into three sections:  The header, the
        -:70623:** cell pointer array, and the cell content area.  Page 1 also has a 100-byte
        -:70624:** file header that occurs before the page header.
        -:70625:**
        -:70626:**      |----------------|
        -:70627:**      | file header    |   100 bytes.  Page 1 only.
        -:70628:**      |----------------|
        -:70629:**      | page header    |   8 bytes for leaves.  12 bytes for interior nodes
        -:70630:**      |----------------|
        -:70631:**      | cell pointer   |   |  2 bytes per cell.  Sorted order.
        -:70632:**      | array          |   |  Grows downward
        -:70633:**      |                |   v
        -:70634:**      |----------------|
        -:70635:**      | unallocated    |
        -:70636:**      | space          |
        -:70637:**      |----------------|   ^  Grows upwards
        -:70638:**      | cell content   |   |  Arbitrary order interspersed with freeblocks.
        -:70639:**      | area           |   |  and free space fragments.
        -:70640:**      |----------------|
        -:70641:**
        -:70642:** The page headers looks like this:
        -:70643:**
        -:70644:**   OFFSET   SIZE     DESCRIPTION
        -:70645:**      0       1      Flags. 1: intkey, 2: zerodata, 4: leafdata, 8: leaf
        -:70646:**      1       2      byte offset to the first freeblock
        -:70647:**      3       2      number of cells on this page
        -:70648:**      5       2      first byte of the cell content area
        -:70649:**      7       1      number of fragmented free bytes
        -:70650:**      8       4      Right child (the Ptr(N) value).  Omitted on leaves.
        -:70651:**
        -:70652:** The flags define the format of this btree page.  The leaf flag means that
        -:70653:** this page has no children.  The zerodata flag means that this page carries
        -:70654:** only keys and no data.  The intkey flag means that the key is an integer
        -:70655:** which is stored in the key size entry of the cell header rather than in
        -:70656:** the payload area.
        -:70657:**
        -:70658:** The cell pointer array begins on the first byte after the page header.
        -:70659:** The cell pointer array contains zero or more 2-byte numbers which are
        -:70660:** offsets from the beginning of the page to the cell content in the cell
        -:70661:** content area.  The cell pointers occur in sorted order.  The system strives
        -:70662:** to keep free space after the last cell pointer so that new cells can
        -:70663:** be easily added without having to defragment the page.
        -:70664:**
        -:70665:** Cell content is stored at the very end of the page and grows toward the
        -:70666:** beginning of the page.
        -:70667:**
        -:70668:** Unused space within the cell content area is collected into a linked list of
        -:70669:** freeblocks.  Each freeblock is at least 4 bytes in size.  The byte offset
        -:70670:** to the first freeblock is given in the header.  Freeblocks occur in
        -:70671:** increasing order.  Because a freeblock must be at least 4 bytes in size,
        -:70672:** any group of 3 or fewer unused bytes in the cell content area cannot
        -:70673:** exist on the freeblock chain.  A group of 3 or fewer free bytes is called
        -:70674:** a fragment.  The total number of bytes in all fragments is recorded.
        -:70675:** in the page header at offset 7.
        -:70676:**
        -:70677:**    SIZE    DESCRIPTION
        -:70678:**      2     Byte offset of the next freeblock
        -:70679:**      2     Bytes in this freeblock
        -:70680:**
        -:70681:** Cells are of variable length.  Cells are stored in the cell content area at
        -:70682:** the end of the page.  Pointers to the cells are in the cell pointer array
        -:70683:** that immediately follows the page header.  Cells is not necessarily
        -:70684:** contiguous or in order, but cell pointers are contiguous and in order.
        -:70685:**
        -:70686:** Cell content makes use of variable length integers.  A variable
        -:70687:** length integer is 1 to 9 bytes where the lower 7 bits of each
        -:70688:** byte are used.  The integer consists of all bytes that have bit 8 set and
        -:70689:** the first byte with bit 8 clear.  The most significant byte of the integer
        -:70690:** appears first.  A variable-length integer may not be more than 9 bytes long.
        -:70691:** As a special case, all 8 bits of the 9th byte are used as data.  This
        -:70692:** allows a 64-bit integer to be encoded in 9 bytes.
        -:70693:**
        -:70694:**    0x00                      becomes  0x00000000
        -:70695:**    0x7f                      becomes  0x0000007f
        -:70696:**    0x81 0x00                 becomes  0x00000080
        -:70697:**    0x82 0x00                 becomes  0x00000100
        -:70698:**    0x80 0x7f                 becomes  0x0000007f
        -:70699:**    0x81 0x91 0xd1 0xac 0x78  becomes  0x12345678
        -:70700:**    0x81 0x81 0x81 0x81 0x01  becomes  0x10204081
        -:70701:**
        -:70702:** Variable length integers are used for rowids and to hold the number of
        -:70703:** bytes of key and data in a btree cell.
        -:70704:**
        -:70705:** The content of a cell looks like this:
        -:70706:**
        -:70707:**    SIZE    DESCRIPTION
        -:70708:**      4     Page number of the left child. Omitted if leaf flag is set.
        -:70709:**     var    Number of bytes of data. Omitted if the zerodata flag is set.
        -:70710:**     var    Number of bytes of key. Or the key itself if intkey flag is set.
        -:70711:**      *     Payload
        -:70712:**      4     First page of the overflow chain.  Omitted if no overflow
        -:70713:**
        -:70714:** Overflow pages form a linked list.  Each page except the last is completely
        -:70715:** filled with data (pagesize - 4 bytes).  The last page can have as little
        -:70716:** as 1 byte of data.
        -:70717:**
        -:70718:**    SIZE    DESCRIPTION
        -:70719:**      4     Page number of next overflow page
        -:70720:**      *     Data
        -:70721:**
        -:70722:** Freelist pages come in two subtypes: trunk pages and leaf pages.  The
        -:70723:** file header points to the first in a linked list of trunk page.  Each trunk
        -:70724:** page points to multiple leaf pages.  The content of a leaf page is
        -:70725:** unspecified.  A trunk page looks like this:
        -:70726:**
        -:70727:**    SIZE    DESCRIPTION
        -:70728:**      4     Page number of next trunk page
        -:70729:**      4     Number of leaf pointers on this page
        -:70730:**      *     zero or more pages numbers of leaves
        -:70731:*/
        -:70732:/* #include "sqliteInt.h" */
        -:70733:
        -:70734:
        -:70735:/* The following value is the maximum cell size assuming a maximum page
        -:70736:** size give above.
        -:70737:*/
        -:70738:#define MX_CELL_SIZE(pBt)  ((int)(pBt->pageSize-8))
        -:70739:
        -:70740:/* The maximum number of cells on a single page of the database.  This
        -:70741:** assumes a minimum cell size of 6 bytes  (4 bytes for the cell itself
        -:70742:** plus 2 bytes for the index to the cell in the page header).  Such
        -:70743:** small cells will be rare, but they are possible.
        -:70744:*/
        -:70745:#define MX_CELL(pBt) ((pBt->pageSize-8)/6)
        -:70746:
        -:70747:/* Forward declarations */
        -:70748:typedef struct MemPage MemPage;
        -:70749:typedef struct BtLock BtLock;
        -:70750:typedef struct CellInfo CellInfo;
        -:70751:
        -:70752:/*
        -:70753:** This is a magic string that appears at the beginning of every
        -:70754:** SQLite database in order to identify the file as a real database.
        -:70755:**
        -:70756:** You can change this value at compile-time by specifying a
        -:70757:** -DSQLITE_FILE_HEADER="..." on the compiler command-line.  The
        -:70758:** header must be exactly 16 bytes including the zero-terminator so
        -:70759:** the string itself should be 15 characters long.  If you change
        -:70760:** the header, then your custom library will not be able to read
        -:70761:** databases generated by the standard tools and the standard tools
        -:70762:** will not be able to read databases created by your custom library.
        -:70763:*/
        -:70764:#ifndef SQLITE_FILE_HEADER /* 123456789 123456 */
        -:70765:#  define SQLITE_FILE_HEADER "SQLite format 3"
        -:70766:#endif
        -:70767:
        -:70768:/*
        -:70769:** Page type flags.  An ORed combination of these flags appear as the
        -:70770:** first byte of on-disk image of every BTree page.
        -:70771:*/
        -:70772:#define PTF_INTKEY    0x01
        -:70773:#define PTF_ZERODATA  0x02
        -:70774:#define PTF_LEAFDATA  0x04
        -:70775:#define PTF_LEAF      0x08
        -:70776:
        -:70777:/*
        -:70778:** An instance of this object stores information about each a single database
        -:70779:** page that has been loaded into memory.  The information in this object
        -:70780:** is derived from the raw on-disk page content.
        -:70781:**
        -:70782:** As each database page is loaded into memory, the pager allocates an
        -:70783:** instance of this object and zeros the first 8 bytes.  (This is the
        -:70784:** "extra" information associated with each page of the pager.)
        -:70785:**
        -:70786:** Access to all fields of this structure is controlled by the mutex
        -:70787:** stored in MemPage.pBt->mutex.
        -:70788:*/
        -:70789:struct MemPage {
        -:70790:  u8 isInit;           /* True if previously initialized. MUST BE FIRST! */
        -:70791:  u8 intKey;           /* True if table b-trees.  False for index b-trees */
        -:70792:  u8 intKeyLeaf;       /* True if the leaf of an intKey table */
        -:70793:  Pgno pgno;           /* Page number for this page */
        -:70794:  /* Only the first 8 bytes (above) are zeroed by pager.c when a new page
        -:70795:  ** is allocated. All fields that follow must be initialized before use */
        -:70796:  u8 leaf;             /* True if a leaf page */
        -:70797:  u8 hdrOffset;        /* 100 for page 1.  0 otherwise */
        -:70798:  u8 childPtrSize;     /* 0 if leaf==1.  4 if leaf==0 */
        -:70799:  u8 max1bytePayload;  /* min(maxLocal,127) */
        -:70800:  u8 nOverflow;        /* Number of overflow cell bodies in aCell[] */
        -:70801:  u16 maxLocal;        /* Copy of BtShared.maxLocal or BtShared.maxLeaf */
        -:70802:  u16 minLocal;        /* Copy of BtShared.minLocal or BtShared.minLeaf */
        -:70803:  u16 cellOffset;      /* Index in aData of first cell pointer */
        -:70804:  int nFree;           /* Number of free bytes on the page. -1 for unknown */
        -:70805:  u16 nCell;           /* Number of cells on this page, local and ovfl */
        -:70806:  u16 maskPage;        /* Mask for page offset */
        -:70807:  u16 aiOvfl[4];       /* Insert the i-th overflow cell before the aiOvfl-th
        -:70808:                       ** non-overflow cell */
        -:70809:  u8 *apOvfl[4];       /* Pointers to the body of overflow cells */
        -:70810:  BtShared *pBt;       /* Pointer to BtShared that this page is part of */
        -:70811:  u8 *aData;           /* Pointer to disk image of the page data */
        -:70812:  u8 *aDataEnd;        /* One byte past the end of the entire page - not just
        -:70813:                       ** the usable space, the entire page.  Used to prevent
        -:70814:                       ** corruption-induced buffer overflow. */
