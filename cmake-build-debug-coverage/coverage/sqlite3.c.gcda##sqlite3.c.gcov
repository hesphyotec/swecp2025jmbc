        -:23622:/*
        -:23623:** SQL is translated into a sequence of instructions to be
        -:23624:** executed by a virtual machine.  Each instruction is an instance
        -:23625:** of the following structure.
        -:23626:*/
        -:23627:typedef struct VdbeOp Op;
