        -:221597:#define RBU_REPLACE    3          /* Delete and then insert a row */
        -:221598:#define RBU_IDX_DELETE 4          /* Delete a row from an aux. index b-tree */
        -:221599:#define RBU_IDX_INSERT 5          /* Insert on an aux. index b-tree */
        -:221600:
        -:221601:#define RBU_UPDATE     6          /* Update a row in a main table b-tree */
