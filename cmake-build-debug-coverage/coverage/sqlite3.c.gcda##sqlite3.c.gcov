        -:71070:  struct KeyInfo *pKeyInfo;            /* Arg passed to comparison function */
        -:71071:  MemPage *pPage;                        /* Current page */
        -:71072:  MemPage *apPage[BTCURSOR_MAX_DEPTH-1]; /* Stack of parents of current page */
        -:71073:};
        -:71074:
        -:71075:/*
        -:71076:** Legal values for BtCursor.curFlags
        -:71077:*/
        -:71078:#define BTCF_WriteFlag    0x01   /* True if a write cursor */
