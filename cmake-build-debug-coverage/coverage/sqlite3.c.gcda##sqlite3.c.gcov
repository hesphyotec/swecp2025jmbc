        -:15819:#define MASKBIT(n)    (((Bitmask)1)<<(n))
        -:15820:#define MASKBIT64(n)  (((u64)1)<<(n))
        -:15821:#define MASKBIT32(n)  (((unsigned int)1)<<(n))
        -:15822:#define SMASKBIT32(n) ((n)<=31?((unsigned int)1)<<(n):0)
        -:15823:#define ALLBITS       ((Bitmask)-1)
        -:15824:#define TOPBIT        (((Bitmask)1)<<(BMS-1))
