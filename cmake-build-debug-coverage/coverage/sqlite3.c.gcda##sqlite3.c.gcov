        -:70431:  if( pHdr1->mxFrame>pHdr2->mxFrame ) return +1;
        -:70432:  return 0;
        -:70433:}
        -:70434:
        -:70435:/*
        -:70436:** The caller currently has a read transaction open on the database.
        -:70437:** This function takes a SHARED lock on the CHECKPOINTER slot and then
        -:70438:** checks if the snapshot passed as the second argument is still
        -:70439:** available. If so, SQLITE_OK is returned.
        -:70440:**
        -:70441:** If the snapshot is not available, SQLITE_ERROR is returned. Or, if
        -:70442:** the CHECKPOINTER lock cannot be obtained, SQLITE_BUSY. If any error
        -:70443:** occurs (any value other than SQLITE_OK is returned), the CHECKPOINTER
        -:70444:** lock is released before returning.
        -:70445:*/
        -:70446:SQLITE_PRIVATE int sqlite3WalSnapshotCheck(Wal *pWal, sqlite3_snapshot *pSnapshot){
