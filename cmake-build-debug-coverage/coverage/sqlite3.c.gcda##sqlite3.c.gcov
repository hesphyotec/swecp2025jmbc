        -:221390:#define RBU_EXCLUSIVE_CHECKPOINT "rbu_exclusive_checkpoint"
        -:221391:
        -:221392:
        -:221393:/*
        -:221394:** The rbu_state table is used to save the state of a partially applied
        -:221395:** update so that it can be resumed later. The table consists of integer
        -:221396:** keys mapped to values as follows:
        -:221397:**
        -:221398:** RBU_STATE_STAGE:
        -:221399:**   May be set to integer values 1, 2, 4 or 5. As follows:
        -:221400:**       1: the *-rbu file is currently under construction.
        -:221401:**       2: the *-rbu file has been constructed, but not yet moved
        -:221402:**          to the *-wal path.
        -:221403:**       4: the checkpoint is underway.
        -:221404:**       5: the rbu update has been checkpointed.
        -:221405:**
        -:221406:** RBU_STATE_TBL:
        -:221407:**   Only valid if STAGE==1. The target database name of the table
        -:221408:**   currently being written.
        -:221409:**
        -:221410:** RBU_STATE_IDX:
        -:221411:**   Only valid if STAGE==1. The target database name of the index
        -:221412:**   currently being written, or NULL if the main table is currently being
        -:221413:**   updated.
        -:221414:**
        -:221415:** RBU_STATE_ROW:
        -:221416:**   Only valid if STAGE==1. Number of rows already processed for the current
        -:221417:**   table/index.
        -:221418:**
        -:221419:** RBU_STATE_PROGRESS:
        -:221420:**   Trbul number of sqlite3rbu_step() calls made so far as part of this
        -:221421:**   rbu update.
        -:221422:**
        -:221423:** RBU_STATE_CKPT:
        -:221424:**   Valid if STAGE==4. The 64-bit checksum associated with the wal-index
        -:221425:**   header created by recovering the *-wal file. This is used to detect
        -:221426:**   cases when another client appends frames to the *-wal file in the
        -:221427:**   middle of an incremental checkpoint (an incremental checkpoint cannot
        -:221428:**   be continued if this happens).
        -:221429:**
        -:221430:** RBU_STATE_COOKIE:
        -:221431:**   Valid if STAGE==1. The current change-counter cookie value in the
        -:221432:**   target db file.
        -:221433:**
        -:221434:** RBU_STATE_OALSZ:
        -:221435:**   Valid if STAGE==1. The size in bytes of the *-oal file.
        -:221436:**
        -:221437:** RBU_STATE_DATATBL:
        -:221438:**   Only valid if STAGE==1. The RBU database name of the table
        -:221439:**   currently being read.
        -:221440:*/
        -:221441:#define RBU_STATE_STAGE        1
        -:221442:#define RBU_STATE_TBL          2
        -:221443:#define RBU_STATE_IDX          3
        -:221444:#define RBU_STATE_ROW          4
        -:221445:#define RBU_STATE_PROGRESS     5
        -:221446:#define RBU_STATE_CKPT         6
        -:221447:#define RBU_STATE_COOKIE       7
        -:221448:#define RBU_STATE_OALSZ        8
        -:221449:#define RBU_STATE_PHASEONESTEP 9
        -:221450:#define RBU_STATE_DATATBL     10
        -:221451:
        -:221452:#define RBU_STAGE_OAL         1
        -:221453:#define RBU_STAGE_MOVE        2
        -:221454:#define RBU_STAGE_CAPTURE     3
        -:221455:#define RBU_STAGE_CKPT        4
        -:221456:#define RBU_STAGE_DONE        5
