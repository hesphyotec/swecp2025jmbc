        -:70426:  /* aSalt[0] is a copy of the value stored in the wal file header. It
        -:70427:  ** is incremented each time the wal file is restarted.  */
        -:70428:  if( pHdr1->aSalt[0]<pHdr2->aSalt[0] ) return -1;
