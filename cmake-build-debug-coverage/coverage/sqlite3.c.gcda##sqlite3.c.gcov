        -:176755:/* The following structure represents a single element of the
        -:176756:** parser's stack.  Information stored includes:
        -:176757:**
        -:176758:**   +  The state number for the parser at this level of the stack.
        -:176759:**
        -:176760:**   +  The value of the token stored at this level of the stack.
        -:176761:**      (In other words, the "major" token.)
        -:176762:**
        -:176763:**   +  The semantic value stored at this level of the stack.  This is
        -:176764:**      the information used by the action routines in the grammar.
        -:176765:**      It is sometimes called the "minor" token.
        -:176766:**
        -:176767:** After the "shift" half of a SHIFTREDUCE action, the stateno field
        -:176768:** actually contains the reduce action for the second half of the
        -:176769:** SHIFTREDUCE.
        -:176770:*/
        -:176771:struct yyStackEntry {
        -:176772:  YYACTIONTYPE stateno;  /* The state-number, or reduce action in SHIFTREDUCE */
        -:176773:  YYCODETYPE major;      /* The major token value.  This is the code
        -:176774:                         ** number for the token at this stack level */
        -:176775:  YYMINORTYPE minor;     /* The user-supplied minor token value.  This
        -:176776:                         ** is the value of the token  */
        -:176777:};
        -:176778:typedef struct yyStackEntry yyStackEntry;
        -:176779:
        -:176780:/* The state of the parser is completely contained in an instance of
        -:176781:** the following structure */
