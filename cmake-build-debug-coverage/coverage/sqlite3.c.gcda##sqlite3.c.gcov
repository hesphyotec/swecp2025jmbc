        -:176786:#endif
        -:176787:#ifndef YYNOERRORRECOVERY
        -:176788:  int yyerrcnt;                 /* Shifts left before out of the error */
        -:176789:#endif
        -:176790:  sqlite3ParserARG_SDECL                /* A place to hold %extra_argument */
        -:176791:  sqlite3ParserCTX_SDECL                /* A place to hold %extra_context */
        -:176792:  yyStackEntry *yystackEnd;           /* Last entry in the stack */
